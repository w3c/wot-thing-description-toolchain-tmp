{
    "@context": "https://www.w3.org/ns/wot-next/td",
    "id": "urn:uuid:b4e8c6a3-9f12-4d7e-85ab-6c0d3e2f1a94",
    "title": "ApiKeyCombinedDevice",
    "securityDefinitions": {
        "apikey_key": {
            "scheme": "apikey",
            "in": "uri",
            "name": "secKey"
        },
        "apikey_id": {
            "scheme": "apikey",
            "in": "uri",
            "name": "secClientID"
        },
        "apikey_combo": {
            "scheme": "combo",
            "allOf": [
                "apikey_key",
                "apikey_id"
            ]
        }
    },
    "security": "apikey_combo",
    "properties": {
        "status": {
            "type": "string",
            "forms": [
                {
                    "href": "https://example.com/{secClientID}/status/{secKey}",
                    "contentType": "application/json"
                }
            ]
        }
    },
    "actions": {
        "toggle": {
            "forms": [
                {
                    "href": "https://example.com/{secClientID}/toggle/{secKey}"
                }
            ]
        }
    }
}
