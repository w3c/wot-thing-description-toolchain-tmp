<https://www.w3.org/2019/wot/td#LinkRelationType#alternate> a owl:Class ;
    rdfs:label "alternate" ;
    rdfs:subClassOf td:LinkRelationType ;
    skos:definition "Points to an alternative representation of the Thing, for example RDF/Turtle or an HTML document." ;
    skos:note "Occurrence - 0..*",
        "Source - IANA Link Relation" .

<https://www.w3.org/2019/wot/td#LinkRelationType#collection> a owl:Class ;
    rdfs:label "collection" ;
    rdfs:subClassOf td:LinkRelationType ;
    skos:definition "Points to a collection of Things." ;
    skos:note "Occurrence - 0..1",
        "Source - IANA Link Relation" .

<https://www.w3.org/2019/wot/td#LinkRelationType#controlledBy> a owl:Class ;
    rdfs:label "controlledBy" ;
    rdfs:subClassOf td:LinkRelationType ;
    skos:definition "Refers to a Thing that controls the context Thing." ;
    skos:note "Occurrence - 0..*",
        "Source - W3C Thing Description" .

<https://www.w3.org/2019/wot/td#LinkRelationType#icon> a owl:Class ;
    rdfs:label "icon" ;
    rdfs:subClassOf td:LinkRelationType ;
