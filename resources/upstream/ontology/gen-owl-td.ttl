    skos:note "Occurrence - 0..*",
        "Source - IANA Link Relation" .

<https://www.w3.org/2019/wot/td#LinkRelationType#predecessor-version> a owl:Class ;
    rdfs:label "predecessor-version" ;
    rdfs:subClassOf td:LinkRelationType ;
    skos:definition "Points to a previous Thing Description or Thing Model version." ;
    skos:note "Occurrence - 0..1",
        "Source - IANA Link Relation" .

<https://www.w3.org/2019/wot/td#LinkRelationType#proxy-to> a owl:Class ;
    rdfs:label "proxy-to" ;
    rdfs:subClassOf td:LinkRelationType ;
    skos:definition "Target resource provides the address of a proxy. Additional security metadata can be provided using the proxy field in a SecurityScheme." ;
    skos:note "Occurrence - 0..*",
        "Source - W3C WoT Security and WoT Binding Template" .

<https://www.w3.org/2019/wot/td#LinkRelationType#service-doc> a owl:Class ;
    rdfs:label "service-doc" ;
    rdfs:subClassOf td:LinkRelationType ;
    skos:definition "Relation to a resource that provide (human-readable) documentation or descriptions." ;
    skos:note "Occurrence - 0..*",
        "Source - IANA Link Relation" .

<https://www.w3.org/2019/wot/td#LinkRelationType#tm%3Aextends> a owl:Class ;
    rdfs:label "tm:extends" ;
    rdfs:subClassOf td:LinkRelationType ;
    skos:definition "Extends an existing definition of the target resource such as a Thing Model. Only applicable for Thing Model definitions." ;
    skos:note "Occurrence - 0..1",
        "Source - W3C WoT Thing Model" .

<https://www.w3.org/2019/wot/td#LinkRelationType#tm%3Asubmodel> a owl:Class ;
    rdfs:label "tm:submodel" ;
    rdfs:subClassOf td:LinkRelationType ;
    skos:definition "Used to compose one or multiple Thing Models. Only applicable for Thing Model definitions." ;
    skos:note "Occurrence - 0..*",
        "Source - W3C WoT Thing Model" .

<https://www.w3.org/2019/wot/td#LinkRelationType#type> a owl:Class ;
    rdfs:label "type" ;
    rdfs:subClassOf td:LinkRelationType ;
    skos:definition "Indicates that the Thing is an instance of the target resource, such as a Thing Model." ;
    skos:note "Occurrence - 0..1",
        "Source - IANA Link Relation" .

<https://www.w3.org/2019/wot/td#OAuth2Flow#client> a owl:Class ;
    rdfs:label "client" ;
    rdfs:subClassOf td:OAuth2Flow ;
    skos:definition "Client credentials flow" .

<https://www.w3.org/2019/wot/td#OAuth2Flow#code> a owl:Class ;
    rdfs:label "code" ;
    rdfs:subClassOf td:OAuth2Flow ;
    skos:definition "Authorization code flow" .

<https://www.w3.org/2019/wot/td#QoPType#auth> a owl:Class ;
    rdfs:label "auth" ;
    rdfs:subClassOf td:QoPType ;
    skos:definition "Authentication only" .

<https://www.w3.org/2019/wot/td#QoPType#auth-int> a owl:Class ;
    rdfs:label "auth-int" ;
    rdfs:subClassOf td:QoPType ;
    skos:definition "Authentication with integrity protection" .

<https://www.w3.org/2019/wot/td#SecurityLocationType#auto> a owl:Class ;
    rdfs:label "auto" ;
    rdfs:subClassOf td:SecurityLocationType ;
    skos:definition "The location is determined as part of the protocol, or negotiated" .

<https://www.w3.org/2019/wot/td#SecurityLocationType#body> a owl:Class ;
    rdfs:label "body" ;
    rdfs:subClassOf td:SecurityLocationType ;
    skos:definition "The parameter will be provided in the body of the request payload" .

<https://www.w3.org/2019/wot/td#SecurityLocationType#cookie> a owl:Class ;
    rdfs:label "cookie" ;
    rdfs:subClassOf td:SecurityLocationType ;
    skos:definition "The parameter is stored in a cookie" .

<https://www.w3.org/2019/wot/td#SecurityLocationType#header> a owl:Class ;
    rdfs:label "header" ;
    rdfs:subClassOf td:SecurityLocationType ;
    skos:definition "The parameter will be given in a header provided by the protocol" .

<https://www.w3.org/2019/wot/td#SecurityLocationType#query> a owl:Class ;
    rdfs:label "query" ;
    rdfs:subClassOf td:SecurityLocationType ;
    skos:definition "The parameter will be appended to the URI as a query parameter" .

<https://www.w3.org/2019/wot/td#SecurityLocationType#uri> a owl:Class ;
    rdfs:label "uri" ;
    rdfs:subClassOf td:SecurityLocationType ;
    skos:definition "The parameter is embedded in the URI itself using a URI template variable" .

<https://www.w3.org/2019/wot/td#SecuritySchemeList#apikey> a owl:Class ;
    rdfs:label "apikey" ;
    rdfs:subClassOf td:SecuritySchemeList ;
    skos:definition "API key authentication using an opaque access token." .

<https://www.w3.org/2019/wot/td#SecuritySchemeList#auto> a owl:Class ;
    rdfs:label "auto" ;
    rdfs:subClassOf td:SecuritySchemeList ;
    skos:definition "Security parameters are negotiated by the underlying protocol at runtime." .

<https://www.w3.org/2019/wot/td#SecuritySchemeList#basic> a owl:Class ;
    rdfs:label "basic" ;
    rdfs:subClassOf td:SecuritySchemeList ;
    skos:definition "HTTP Basic authentication using a username and password." .

<https://www.w3.org/2019/wot/td#SecuritySchemeList#bearer> a owl:Class ;
    rdfs:label "bearer" ;
    rdfs:subClassOf td:SecuritySchemeList ;
    skos:definition "Bearer token authentication independent of OAuth 2.0." .

<https://www.w3.org/2019/wot/td#SecuritySchemeList#combo> a owl:Class ;
    rdfs:label "combo" ;
    rdfs:subClassOf td:SecuritySchemeList ;
    skos:definition "A combination of named security schemes using oneOf or allOf." .

<https://www.w3.org/2019/wot/td#SecuritySchemeList#digest> a owl:Class ;
    rdfs:label "digest" ;
    rdfs:subClassOf td:SecuritySchemeList ;
    skos:definition "HTTP Digest Access Authentication." .

<https://www.w3.org/2019/wot/td#SecuritySchemeList#nosec> a owl:Class ;
    rdfs:label "nosec" ;
    rdfs:subClassOf td:SecuritySchemeList ;
    skos:definition "No authentication or other security mechanism is required." .

<https://www.w3.org/2019/wot/td#SecuritySchemeList#oauth2> a owl:Class ;
    rdfs:label "oauth2" ;
    rdfs:subClassOf td:SecuritySchemeList ;
    skos:definition "OAuth 2.0 authentication." .

<https://www.w3.org/2019/wot/td#SecuritySchemeList#psk> a owl:Class ;
    rdfs:label "psk" ;
    rdfs:subClassOf td:SecuritySchemeList ;
    skos:definition "Pre-shared key authentication, for example TLS-PSK." .

<https://www.w3.org/2019/wot/td#SubprotocolList#longpoll> a owl:Class ;
    rdfs:label "longpoll" ;
    rdfs:subClassOf td:SubprotocolList ;
    skos:definition "Long polling subprotocol." .

<https://www.w3.org/2019/wot/td#SubprotocolList#sse> a owl:Class ;
    rdfs:label "sse" ;
    rdfs:subClassOf td:SubprotocolList ;
    skos:definition "Server-Sent Events subprotocol." .

<https://www.w3.org/2019/wot/td#SubprotocolList#websub> a owl:Class ;
    rdfs:label "websub" ;
    rdfs:subClassOf td:SubprotocolList ;
    skos:definition "WebSub subprotocol." .

td:actions a owl:ObjectProperty ;
    rdfs:label "actions" ;
    rdfs:range td:ActionAffordance ;
    rdfs:subPropertyOf td:hasInteractionAffordance ;
    skos:definition "All Action-based Interaction Affordances of the Thing." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:jsonld_index "td:name" .

td:cancelAction a owl:Class ;
    rdfs:label "cancelaction" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the cancel operation on Action Affordances to cancel the ongoing corresponding action." ;
    skos:note "No correlation, additionalResponses can be used in the form level" .

td:events a owl:ObjectProperty ;
    rdfs:label "events" ;
    rdfs:range td:EventAffordance ;
    rdfs:subPropertyOf td:hasInteractionAffordance ;
    skos:definition "All Event-based Interaction Affordances of the Thing." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:jsonld_index "td:name" .

td:invokeAction a owl:Class ;
    rdfs:label "invokeaction" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the invoke operation on Action Affordances to perform the corresponding action." ;
    skos:note "Consumer to Thing - Value of the input key",
        "Thing to Consumer - Value of the output key" .

td:links a owl:ObjectProperty ;
    rdfs:label "links" ;
    rdfs:range hctl:Link ;
    skos:definition "Provides Web links to arbitrary resources that relate to the specified Thing Description." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> .

td:observeAllProperties a owl:Class ;
    rdfs:label "observeallproperties" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the observeallproperties operation on Properties to be notified with new data when any Property is updated." .

td:observeProperty a owl:Class ;
    rdfs:label "observeproperty" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the observe operation on Property Affordances to be notified with the new data when the Property is updated." ;
    skos:note "Consumer to Thing - No correlation",
        "Thing to Consumer - All fields in the Property Affordance without \"writeOnly\":true" .

td:queryAction a owl:Class ;
    rdfs:label "queryaction" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the querying operation on Action Affordances to get the status of the corresponding action." ;
    skos:note "No correlation, additionalResponses can be used in the form level" .

td:queryAllActions a owl:Class ;
    rdfs:label "queryallactions" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the queryallactions operation on a Thing to get the status of all Actions in a single interaction." .

td:readAllProperties a owl:Class ;
    rdfs:label "readallproperties" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the readallproperties operation on a Thing to retrieve the data of all Properties in a single interaction." .

td:readMultipleProperties a owl:Class ;
    rdfs:label "readmultipleproperties" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the readmultipleproperties operation on a Thing to retrieve the data of selected Properties in a single interaction." .

td:readProperty a owl:Class ;
    rdfs:label "readproperty" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the read operation on Property Affordances to retrieve the corresponding data." ;
    skos:note "Consumer to Thing - No correlation",
        "Thing to Consumer - All fields in the Property Affordance without \"writeOnly\":true" .

td:schemaDefinitions a owl:ObjectProperty ;
    rdfs:label "schemaDefinitions" ;
    rdfs:range jsonschema:DataSchema ;
    skos:definition "Set of named data schemas. To be used in a schema name-value pair inside an AdditionalExpectedResponse object." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:jsonld_index "td:hasInstanceConfiguration" ;
    td:spec_description "Set of named data schemas. To be used in a schema name-value pair inside an `AdditionalExpectedResponse` object." .

td:securityDefinitions a owl:ObjectProperty ;
    rdfs:label "securityDefinitions" ;
    rdfs:range wotsec:SecurityScheme ;
    skos:definition "A Thing may define abstract security schemes, used to configure the secure access of (a set of) affordance(s)." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:jsonld_index "td:hasInstanceConfiguration" ;
    td:spec_description "Set of named security configurations (definitions only). Not actually applied unless names are used in a `security` name-value pair." .

td:subscribeAllEvents a owl:Class ;
    rdfs:label "subscribeallevents" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the subscribeallevents operation on Events to subscribe to notifications from all Events in a single interaction." .

td:subscribeEvent a owl:Class ;
    rdfs:label "subscribeevent" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the subscribe operation on Event Affordances to be notified by the Thing when the event occurs." ;
    skos:note "Consumer to Thing - Value of the subscription key with all fields without \"readOnly\":true",
        "Thing to Consumer - Value of the subscription key with all fields without \"writeOnly\":true" .

td:unobserveAllProperties a owl:Class ;
    rdfs:label "unobserveallproperties" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the unobserveallproperties operation on Properties to stop notifications from all Properties in a single interaction." .

td:unobserveProperty a owl:Class ;
    rdfs:label "unobserveproperty" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the unobserve operation on Property Affordances to stop the corresponding notifications." ;
    skos:note "No payload correlation in either direction" .

td:unsubscribeAllEvents a owl:Class ;
    rdfs:label "unsubscribeallevents" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the unsubscribeallevents operation on Events to unsubscribe from notifications from all Events in a single interaction." .

td:unsubscribeEvent a owl:Class ;
    rdfs:label "unsubscribeevent" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the unsubscribe operation on Event Affordances to stop the corresponding notifications." ;
    skos:note "Consumer to Thing - Value of the subscription key with all fields without \"readOnly\":true",
        "Thing to Consumer - Value of the subscription key with all fields without \"writeOnly\":true" .

td:writeAllProperties a owl:Class ;
    rdfs:label "writeallproperties" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the writeallproperties operation on a Thing to update the data of all writable Properties in a single interaction." .

td:writeMultipleProperties a owl:Class ;
    rdfs:label "writemultipleproperties" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the writemultipleproperties operation on a Thing to update the data of selected writable Properties in a single interaction." .

td:writeProperty a owl:Class ;
    rdfs:label "writeproperty" ;
    rdfs:subClassOf td:OperationType ;
    skos:definition "Identifies the write operation on Property Affordances to update the corresponding data." ;
    skos:note "Consumer to Thing - All fields in the Property Affordance without \"readOnly\":true",
        "Thing to Consumer - No correlation, additionalResponses can be used in the form level" .

hctl:AdditionalExpectedResponse a owl:Class ;
    rdfs:label "AdditionalExpectedResponse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:schema ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:contentType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hctl:schema ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:success ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hctl:contentType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:contentType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:success ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty hctl:success ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:schema ] ;
    skos:definition "Communication metadata describing the expected response message for additional responses." ;
    skos:exactMatch hctl:AdditionalExpectedResponse ;
    skos:inScheme hctl: ;
    td:spec_content "[{'type': 'paragraph', 'segments': [{'text': 'In some cases additional responses might be possible. One example of this is error responses but in some cases there might also be additional successful responses. In this case, the `response` name-value pair is still used for the primary response but `additionalResponses` may also be provided, whose value is an array of `AdditionalExpectedResponse` objects. Each additional response must be distinguished in some way from the primary response, either by `contentType` or by protocol-specific settings such as error code header values. Each additional response may also have a data schema which can differ from the normal output data schema for the interaction.\\n'}]}, {'type': 'markdown', 'text': 'Similar expected response, additional responses have the following considerations:'}, {'type': 'list', 'items': [{'id': 'td-additionalExpectedResponse-contentType', 'text': 'If the content type of an additional expected response differs from the content type of the form, the `Form` instance *MUST* include an entry in the array associated with the name `additionalResponses`.\\n'}, {'id': 'td-additionalExpectedResponse-missing-contentType', 'text': 'If there is no `contentType` value defined in an additional expected response object, a Consumer *MUST* expect that the respective response does not contain any payload.\\n'}, {'id': 'td-additionalExpectedResponse-schema', 'text': 'If the data schema of an additional expected response differs from the output data schema of the interaction, the `Form` *MUST* include an entry in the array associated with the name `additionalResponses` that includes a value for the name `schema`.\\n'}, {'id': 'td-additionalExpectedResponse-noSchemaWithoutPayload', 'text': 'The `schema` of an additional expected response object *MUST NOT* be defined when there is no `contentType` present.\\n'}]}, {'type': 'markdown', 'text': 'The different cases on the variation of request and response are explained above. The tables at [contentType-usage](#contentType-usage) summarize these cases in a concise manner.\\n'}]" .

hctl:ExpectedResponse a owl:Class ;
    rdfs:label "ExpectedResponse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hctl:contentType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:contentType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:contentType ] ;
    skos:definition "Communication metadata describing the expected response message for the primary response." ;
    skos:exactMatch hctl:ExpectedResponse ;
    skos:inScheme hctl: ;
    td:spec_content "[{'type': 'paragraph', 'segments': [{'text': 'The optional `response` name-value pair can be used to provide metadata for the expected response message. With the core vocabulary, it can include only content type information, but TD Context Extensions could be applied.\\n'}, {'id': 'td-expectedResponse-default-contentType', 'text': 'If no `response` name-value pair is provided, it *MUST* be assumed that the content type of the response is equal to the content type assigned to the Form instance.\\n'}, {'text': 'Note that `contentType` within an `ExpectedResponse` Class does not have a Default Value.\\n'}]}, {'type': 'paragraph', 'segments': [{'text': 'In some use cases, input and output data might be represented in a different form, for instance an Action that accepts JSON, but returns an image. In such a case, the optional `response` key-value pair can describe the content type of the expected response. As there is no default value defined, the following assertions apply:\\n'}]}, {'type': 'list', 'items': [{'id': 'td-expectedResponse-missing-contentType', 'text': 'If there is no `contentType` value defined in a `response` object within a form, a Consumer *MUST* expect that the respective response does not contain any payload.\\n'}, {'id': 'td-expectedResponse-defined-contentType', 'text': 'If a content type is defined in the `response` object within a form, a Consumer *MUST* expect a response containing a payload in the respective format, e.g., an image in the case of `image/jpeg`.\\n'}]}]" .

hctl:anchor a owl:DatatypeProperty ;
    rdfs:label "anchor" ;
    skos:definition "Overrides the link context (by default the Thing itself identified by its id) with the given URI or IRI." ;
    skos:inScheme hctl: .

hctl:contentCoding a owl:DatatypeProperty ;
    rdfs:label "contentCoding" ;
    rdfs:range xsd:string ;
    skos:definition "Content coding values indicate an encoding transformation that has been or can be applied to a representation. Content codings are primarily used to allow a representation to be compressed or otherwise usefully transformed without losing the identity of its underlying media type and without loss of information. Examples of content coding include \"gzip\", \"deflate\", etc." ;
    skos:inScheme hctl: .

hctl:hreflang a owl:DatatypeProperty ;
    rdfs:label "hreflang" ;
    skos:definition "The hreflang attribute specifies the language of a linked document. The value of this must be a valid  language tag [BCP47]." ;
    skos:inScheme hctl: ;
    skos:note "The hreflang attribute is allowed to be a string or array in this version of the spec" ;
    td:spec_description "The hreflang attribute specifies the language of a linked document. The value of this must be a valid language tag [[BCP47]]." .

hctl:op a owl:DatatypeProperty ;
    rdfs:label "op" ;
    rdfs:range [ owl:unionOf ( [ a rdfs:Datatype ;
                        owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                    owl:datatypeComplementOf xsd:string ] ) ] [ a rdfs:Datatype ;
                        owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                    owl:datatypeComplementOf xsd:string ] ) ] ) ] ;
    skos:definition "Indicates the operation type (e.g., readproperty, writeproperty, observeproperty, etc.)" ;
    skos:inScheme hctl: ;
    td:spec_description "Indicates the semantic intention of performing the operation(s) described by the form. For example, the Property interaction allows get and set operations. The protocol binding may contain a form for the get operation and a different form for the set operation. The op attribute indicates which form is for which and allows the client to select the correct form for the operation required. op can be assigned one or more interaction verb(s) each representing a semantic intention of an operation." .

hctl:response a owl:ObjectProperty ;
    rdfs:label "response" ;
    rdfs:range hctl:ExpectedResponse ;
    skos:definition "This optional term can be used if, e.g., the output communication metadata differ from input metadata (e.g., output contentType differ from the input contentType). The response name contains metadata that is only valid for the primary response messages." ;
    skos:inScheme hctl: .

hctl:schema a owl:DatatypeProperty ;
    rdfs:label "schema" ;
    skos:definition "Used to define the output data schema for an additional response if it differs from the default output data schema. Rather than a DataSchema object, the name of a previous definition given in a schemaDefinitions map must be used." ;
    skos:inScheme hctl: ;
    td:spec_description "Used to define the output data schema for an additional response if it differs from the default output data schema. Rather than a `DataSchema` object, the name of a previous definition given in a `schemaDefinitions` map must be used." .

hctl:subprotocol a owl:ObjectProperty ;
    rdfs:label "subprotocol" ;
    rdfs:range td:SubprotocolList ;
    skos:definition "Indicates the exact protocol that should be used for additional notifications." ;
    skos:inScheme hctl: ;
    td:spec_description "Indicates the exact mechanism by which an interaction will be accomplished for a given protocol when there are multiple options. For example, for HTTP and Events, it indicates which of several available mechanisms should be used for asynchronous notifications such as long polling (`longpoll`), WebSub [[websub]] (websub), Server-Sent Events (`sse`) [[html]] (also known as EventSource). Please note that there is no restriction on the subprotocol selection and other mechanisms can also be announced by this subprotocol term." .

hctl:success a owl:DatatypeProperty ;
    rdfs:label "success" ;
    skos:definition "Signals if an additional response should not be considered an error." ;
    skos:inScheme hctl: ;
    td:spec_default true .

hctl:type a owl:DatatypeProperty ;
    rdfs:label "type" ;
    skos:definition "Target attribute providing a hint indicating what the media type [RFC2046] of the result of  dereferencing the link should be." ;
    skos:inScheme hctl: ;
    td:spec_description "Target attribute providing a hint indicating what the media type [[RFC2046]] of the result of dereferencing the link should be." .

jsonschema:const a owl:ObjectProperty ;
    rdfs:label "const" ;
    rdfs:range jsonschema:Any ;
    skos:definition "Provides a constant value." ;
    skos:inScheme jsonschema: .

jsonschema:contentEncoding a owl:ObjectProperty ;
    rdfs:label "contentEncoding" ;
    skos:definition "Specifies the encoding used to store the contents, as specified in RFC 2045 (Section 6.1) and RFC 4648." ;
    skos:inScheme jsonschema: ;
    td:spec_description "Specifies the encoding used to store the contents, as specified in [[RFC2045]] (Section 6.1) and [[RFC4648]]." .

jsonschema:contentMediaType a owl:ObjectProperty ;
    rdfs:label "contentMediaType" ;
    skos:definition "Specifies the MIME type of the contents of a string value, as described in RFC 2046." ;
    skos:inScheme jsonschema: ;
    td:spec_description "Specifies the MIME type of the contents of a string value, as described in [[RFC2046]]." .

jsonschema:default a owl:ObjectProperty ;
    rdfs:label "default" ;
    rdfs:range jsonschema:Any ;
    skos:definition "Supply a default value. The value SHOULD validate against the data schema in which it resides." ;
    skos:inScheme jsonschema: ;
    td:spec_description "Supply a default value. The value SHOULD validate against the data schema in which it resides." .

jsonschema:format a owl:DatatypeProperty ;
    rdfs:label "format" ;
    rdfs:range xsd:string ;
    skos:definition "Allows validation based on a format pattern such as \"date-time\", \"email\", \"uri\", etc." ;
    skos:inScheme jsonschema: ;
    td:spec_description "Allows validation based on a format pattern such as \"date-time\", \"email\", \"uri\", etc. (Also see below.)" .

jsonschema:items a owl:DatatypeProperty ;
    rdfs:label "items" ;
    skos:definition "Used to define the characteristics of an array." ;
    skos:inScheme jsonschema: .

jsonschema:maxItems a owl:DatatypeProperty ;
    rdfs:label "maxItems" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:nonNegativeInteger [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "Defines the maximum number of items that have to be in the array." ;
    skos:inScheme jsonschema: .

jsonschema:maxLength a owl:DatatypeProperty ;
    rdfs:label "maxLength" ;
    skos:definition "Specifies the maximum length of a string. Only applicable for associated string types." ;
    skos:inScheme jsonschema: .

jsonschema:minItems a owl:DatatypeProperty ;
    rdfs:label "minItems" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:nonNegativeInteger [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "Defines the minimum number of items that have to be in the array." ;
    skos:inScheme jsonschema: .

jsonschema:minLength a owl:DatatypeProperty ;
    rdfs:label "minLength" ;
    skos:definition "Specifies the minimum length of a string. Only applicable for associated string types." ;
    skos:inScheme jsonschema: .

jsonschema:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    skos:definition "Name of the data schema definition." ;
    skos:inScheme jsonschema: ;
    td:spec_exclude true .

jsonschema:pattern a owl:DatatypeProperty ;
    rdfs:label "pattern" ;
    skos:definition "Provides a regular expression to express constraints of the string value. The regular expression must follow the ECMA 262 dialect." ;
    skos:inScheme jsonschema: ;
    td:spec_description "Provides a regular expression to express constraints of the string value. The regular expression must follow the [[ECMA-262]] dialect." .

jsonschema:readOnly a owl:DatatypeProperty ;
    rdfs:label "readOnly" ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean value that is a hint to indicate whether a property interaction / value is read only (=true) or not (=false). Also see Interaction Semantics for further information on the usage patterns and implications." ;
    skos:inScheme jsonschema: ;
    td:spec_description "Boolean value that is a hint to indicate whether a property interaction / value is read only (=true) or not (=false). Also see [[[#interaction-semantics]]] for further information on the usage patterns and implications." .

jsonschema:type a owl:ObjectProperty ;
    rdfs:label "type" ;
    rdfs:range linkml:uri ;
    skos:definition "Assignment of JSON-based data types compatible with JSON Schema (one of boolean, integer, number, string, object, array, or null)." ;
    skos:inScheme jsonschema: .

jsonschema:unit a owl:DatatypeProperty ;
    rdfs:label "unit" ;
    rdfs:range xsd:string ;
    skos:definition "Provides unit information that is used, e.g., in international science, engineering, and business. To preserve uniqueness, it is recommended that the value of the unit points to a semantic definition." ;
    skos:inScheme jsonschema: ;
    td:spec_description "Provides unit information that is used, e.g., in international science, engineering, and business. To preserve uniqueness, it is recommended that the value of the unit points to a semantic definition (also see Section [Semantic Annotations](#semantic-annotations-example-version-units))." .

jsonschema:writeOnly a owl:DatatypeProperty ;
    rdfs:label "writeOnly" ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean value that is a hint to indicate whether a property interaction / value is write only (=true) or not (=false). Also see Interaction Semantics for further information on the usage patterns and implications." ;
    skos:inScheme jsonschema: ;
    td:spec_description "Boolean value that is a hint to indicate whether a property interaction / value is write only (=true) or not (=false). Also see [[[#interaction-semantics]]] for further information on the usage patterns and implications." .

wotsec:alg a owl:ObjectProperty ;
    rdfs:label "alg" ;
    rdfs:range td:AlgList ;
    skos:definition "Encoding, encryption, or digest algorithm (e.g., ES256, ES512-256)." ;
    skos:inScheme wotsec: ;
    td:spec_description "Encoding, encryption, or digest algorithm." .

wotsec:flow a owl:ObjectProperty ;
    rdfs:label "flow" ;
    rdfs:range td:OAuth2Flow ;
    skos:definition "Authorization flow." ;
    skos:inScheme wotsec: .

wotsec:format a owl:ObjectProperty ;
    rdfs:label "format" ;
    skos:definition "Specifies format of security authentication information." ;
    skos:inScheme wotsec: ;
    td:spec_default true ;
    td:spec_type_values "JsonObj(mode='examples', values=['jwt', 'cwt', 'jwe', 'jws'])" .

wotsec:identity a owl:DatatypeProperty ;
    rdfs:label "identity" ;
    rdfs:range xsd:string ;
    skos:definition "Identifier providing information which can be used for selection or confirmation." ;
    skos:inScheme wotsec: .

wotsec:proxy a owl:DatatypeProperty ;
    rdfs:label "proxy" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URI of the proxy server this security configuration provides access to. If not given, the corresponding  security configuration is for the endpoint." ;
    skos:inScheme wotsec: ;
    skos:note "This feature is at risk." .

wotsec:qop a owl:ObjectProperty ;
    rdfs:label "qop" ;
    rdfs:range td:QoPType ;
    skos:definition "Quality of protection." ;
    skos:inScheme wotsec: ;
    skos:note "This feature is at risk." .

wotsec:refresh a owl:DatatypeProperty ;
    rdfs:label "refresh" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URI of the refresh server." ;
    skos:inScheme wotsec: .

wotsec:security_scheme_key a owl:DatatypeProperty ;
    rdfs:label "security_scheme_key" ;
    skos:definition "Name of the security scheme definition." ;
    skos:inScheme wotsec: ;
    td:spec_exclude true .

wotsec:token a owl:DatatypeProperty ;
    rdfs:label "token" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URI of the token server." ;
    skos:inScheme wotsec: .

td:ContentMediaTypeList a owl:Class ;
    rdfs:label "contentMediaTypeList" ;
    owl:unionOf ( <https://www.w3.org/2019/wot/td#ContentMediaTypeList#image%2Fpng> <https://www.w3.org/2019/wot/td#ContentMediaTypeList#audio%2Fmpeg> ) ;
    skos:definition "Specifies the MIME type of the contents of a string value" ;
    skos:inScheme jsonschema: ;
    linkml:permissible_values <https://www.w3.org/2019/wot/td#ContentMediaTypeList#audio%2Fmpeg>,
        <https://www.w3.org/2019/wot/td#ContentMediaTypeList#image%2Fpng> .

td:VersionInfo a owl:Class ;
    rdfs:label "VersionInfo" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:instance ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty td:instance ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty td:instance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:model ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty td:model ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:model ] ;
    skos:definition "Metadata of a Thing that provides version information about the TD document. If required, additional version information such as firmware and hardware version (term definitions outside of the TD namespace) can be extended via the TD Context Extension mechanism." ;
    skos:exactMatch td:VersionInfo ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_content "[{'type': 'markdown', 'text': 'It is recommended that the values within `instances` and `model` of the `VersionInfo` [Class](#dfn-class) follow the semantic versioning pattern, where a sequence of three numbers separated by a dot indicates the major version, minor version, and patch version, respectively. See [[SEMVER]] for details.'}]" .

td:atContext a owl:DatatypeProperty ;
    rdfs:label "atContext" ;
    rdfs:range [ owl:unionOf ( [ owl:intersectionOf ( linkml:uri [ owl:complementOf [ owl:unionOf ( xsd:anyURI jsonschema:Any ) ] ] ) ] [ owl:intersectionOf ( [ owl:unionOf ( xsd:anyURI jsonschema:Any ) ] [ owl:complementOf linkml:uri ] ) ] ) ] ;
    skos:definition "JSON-LD keyword to define short-hand names called terms that are used throughout a TD document." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    skos:prefLabel "@context" .

td:base a owl:DatatypeProperty ;
    rdfs:label "base" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Define the base URI that is used for all relative URI references throughout a TD document. In TD instances, all relative URIs are resolved relative to the base URI using the algorithm defined in [RFC3986].  base does not affect the URIs used in @context and the IRIs used within Linked Data graphs that are relevant when semantic processing is applied to TD instances." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_description """Define the absolute base URI that is used for all relative URI references throughout a TD document. In TD instances, all relative URIs are resolved relative to the base URI using the algorithm defined in [[RFC3986]].
`base` does not affect the URIs used in `@context` and the IRIs used within Linked Data [[LINKED-DATA]] graphs that are relevant when semantic processing is applied to TD instances.
Also see [the note](#note-uri-iri) about the type of base URI.""" .

td:cancellation a owl:ObjectProperty ;
    rdfs:label "cancellation" ;
    skos:definition "Defines any data that needs to be passed to cancel a subscription, e.g., a specific message to remove a Webhook." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> .

td:created a owl:AnnotationProperty ;
    rdfs:label "created" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Provides information when the TD instance was created." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> .

td:data a owl:ObjectProperty ;
    rdfs:label "data" ;
    skos:definition "Defines the data schema of the Event instance messages pushed by the Thing." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> .

td:dataResponse a owl:ObjectProperty ;
    rdfs:label "dataResponse" ;
    skos:definition "Defines the data schema of the Event response messages sent by the consumer in a response to a data message." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> .

td:hasInteractionAffordance a owl:ObjectProperty ;
    rdfs:label "hasInteractionAffordance" ;
    rdfs:range td:InteractionAffordance ;
    skos:definition "Offers an affordance to interact with the Thing." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> .

td:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Identifier of the Thing in form of a URI RFC3986 (e.g., stable URI, temporary and mutable URI, URI with local IP address, URN, etc.)." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_description "Identifier of the Thing in form of a URI [[RFC3986]] (e.g., stable URI, temporary and mutable URI, URI with local IP address, URN, etc.)." .

td:idempotent a owl:DatatypeProperty ;
    rdfs:label "idempotent" ;
    skos:definition "Indicates whether the action is idempotent (=true) or not. Informs whether the action can be called repeatedly with the same result, if present, based on the same input." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_default true ;
    td:spec_description "Indicates whether the Action is idempotent (=true) or not. Informs whether the Action can be called repeatedly with the same result, if present, based on the same input." .

td:input a owl:ObjectProperty ;
    rdfs:label "input" ;
    skos:definition "Used to define the input data schema of the action." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_description "Used to define the input data schema of the Action." .

td:instance a owl:DatatypeProperty ;
    rdfs:label "instance" ;
    skos:definition "Provides a version indicator of this TD instance." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_description "Provides a version indicator of this TD." .

td:language_tag a owl:DatatypeProperty ;
    rdfs:label "language_tag" ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_exclude true .

td:language_value a owl:DatatypeProperty ;
    rdfs:label "language_value" ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_exclude true .

td:model a owl:DatatypeProperty ;
    rdfs:label "model" ;
    skos:definition "Provides a version indicator of the underlying TM." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> .

td:modified a owl:AnnotationProperty ;
    rdfs:label "modified" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Provides information when the TD instance was last modified." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> .

td:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    skos:definition "Indexing property to store entity names when serializing them in a JSON-LD @index container." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_description "Name of the interaction affordance." ;
    td:spec_exclude true .

td:observable a owl:DatatypeProperty ;
    rdfs:label "observable" ;
    skos:definition "A hint that indicates whether Servients hosting the Thing and Intermediaries should provide a Protocol Binding that supports the observeproperty and unobserveproperty operations for this Property." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_default true ;
    td:spec_description "A hint that indicates whether Servients hosting the Thing and Intermediaries should provide a Protocol Binding that supports the `observeproperty` and `unobserveproperty` operations for this Property. Also see [[[#interaction-semantics]]] for further information on the usage patterns and implications." .

td:output a owl:ObjectProperty ;
    rdfs:label "output" ;
    skos:definition "Used to define the output data schema of the action." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_description "Used to define the output data schema of the Action." .

td:profile a owl:DatatypeProperty ;
    rdfs:label "profile" ;
    rdfs:range [ owl:unionOf ( [ a rdfs:Datatype ;
                        owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                    owl:datatypeComplementOf xsd:anyURI ] ) ] [ a rdfs:Datatype ;
                        owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                    owl:datatypeComplementOf xsd:anyURI ] ) ] ) ] ;
    skos:definition "Indicates the WoT Profile mechanisms followed by this Thing Description and the corresponding Thing implementation." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> .

td:safe a owl:DatatypeProperty ;
    rdfs:label "safe" ;
    skos:definition "Signals if the action is safe (=true) or not. Used to signal if there is no internal state (cf. resource state) is changed when invoking an Action. In that case responses can be cached as example." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_default true ;
    td:spec_description "Signals if the Action is safe (=true) or not. Used to signal if there is no internal state (cf. resource state) is changed when invoking an Action. In that case responses can be cached as example." .

td:subscription a owl:ObjectProperty ;
    rdfs:label "subscription" ;
    skos:definition "Defines data that needs to be passed upon subscription, e.g., filters or message format for setting up Webhooks." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> .

td:support a owl:AnnotationProperty ;
    rdfs:label "support" ;
    rdfs:range xsd:anyURI ;
    rdfs:seeAlso schema1:contactPoint ;
    skos:definition "Provides information about the TD maintainer as URI scheme (e.g., mailto [[RFC6068]], tel [[RFC3966]], https [[RFC9112]])." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_description "Provides information about the TD maintainer as URI scheme (e.g., `mailto` [[RFC6068]], `tel` [[RFC3966]], `https` [[RFC9112]])." .

td:synchronous a owl:DatatypeProperty ;
    rdfs:label "synchronous" ;
    skos:definition "Indicates whether the action is synchronous (=true) or not. A synchronous action means that the response of action contains all the information about the result of the action and no further querying about the status of the action is needed." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_description "Indicates whether the action is synchronous (=true) or not. A synchronous action means that the response of action contains all the information about the result of the action and no further querying about the status of the action is needed. Lack of this keyword means that no claim on the synchronicity of the action can be made." .

td:version a owl:ObjectProperty ;
    rdfs:label "version" ;
    rdfs:range td:VersionInfo ;
    skos:definition "Provides version information." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> .

hctl:Form a owl:Class ;
    rdfs:label "Form" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom hctl:ExpectedResponse ;
            owl:onProperty hctl:response ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:response ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( xsd:string xsd:string ) ] [ owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                                        owl:datatypeComplementOf xsd:string ] ) ] [ a rdfs:Datatype ;
                                            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                                        owl:datatypeComplementOf xsd:string ] ) ] ) ] ) ] ;
            owl:onProperty wotsec:scopes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:op ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( [ a rdfs:Datatype ;
                                owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                            owl:datatypeComplementOf xsd:string ] ) ] [ a rdfs:Datatype ;
                                owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                            owl:datatypeComplementOf xsd:string ] ) ] ) ] ;
            owl:onProperty hctl:op ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:contentCoding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:response ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( [ a rdfs:Datatype ;
                                owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                            owl:datatypeComplementOf xsd:string ] ) ] [ a rdfs:Datatype ;
                                owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                            owl:datatypeComplementOf xsd:string ] ) ] ) ] ;
            owl:onProperty td:security ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:subprotocol ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hctl:subprotocol ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:security ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:contentType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:additionalResponses ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hctl:href ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:contentType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:scopes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:subprotocol ],
        [ a owl:Restriction ;
            owl:allValuesFrom hctl:AdditionalExpectedResponse ;
            owl:onProperty hctl:additionalResponses ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hctl:contentType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hctl:href ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hctl:contentCoding ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:scopes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:security ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:href ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:op ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:contentCoding ] ;
    skos:definition "A form hypermedia control that describes how an operation can be performed." ;
    skos:exactMatch hctl:Form ;
    skos:inScheme hctl: ;
    td:jsonschema_form_variants "JsonObj(op_slot='op', variants=JsonObj(property=['readproperty', 'writeproperty', 'observeproperty', 'unobserveproperty'], action=['invokeaction', 'queryaction', 'cancelaction'], event=['subscribeevent', 'unsubscribeevent'], root=['readallproperties', 'writeallproperties', 'readmultipleproperties', 'writemultipleproperties', 'observeallproperties', 'unobserveallproperties', 'queryallactions', 'subscribeallevents', 'unsubscribeallevents']))" ;
    td:spec_content "[{'type': 'note', 'text': 'The value of the `href` property in a Form instance can be a relative URI or an absolute URI.\\n'}, {'type': 'assertion', 'id': 'td-form-href-relative', 'text': 'To properly build the target URI, if base is present in the Thing level, the `href` value *MUST* be resolved using the base URI.\\n'}, {'type': 'paragraph', 'segments': [{'text': 'While this table defines the terms available in a form,\\n'}, {'id': 'td-form-additional-mediatype-metadata', 'text': 'Bindings *MAY* have additional information that specifies representation formats in more detail than the media type alone.\\n'}, {'text': 'For example, in a TD with the Modbus Binding, `modv:mostSignificantByte` in a form describes the endianness of the payload. Please see [Bindings](#bindings) for further information. Furthermore, possible values for the `contentCoding` property can be found, e.g., in the IANA HTTP content coding registry.\\n'}]}, {'type': 'paragraph', 'segments': [{'text': 'The list of possible operation types of a form is fixed. As of this version of the specification, it only includes the well-known types necessary to implement the WoT interaction model described in [[wot-architecture11]]. Future versions of the standard may extend this list but\\n'}, {'id': 'well-known-operation-types-only', 'text': 'operations types *MUST* be restricted to the values in the table below.\\n'}]}, {'type': 'enum_table', 'enum': 'OperationType', 'caption': 'Well-known operation types', 'table_id': 'table-operation-types', 'columns': [{'field': 'name', 'header': 'Operation Type'}, {'field': 'description', 'header': 'Description'}]}, {'type': 'markdown', 'text': 'A Thing Description of a WoT producer may have multiple forms entries with, e.g., different protocol and/or content types declarations that a Consumer could possibly support. In that case the Consumer may choose any form entry that works (e.g., the protocol and content type is supported) for them. When one form is chosen, it is expected that the Consumer will continue to use it as long as possible for every new interaction with the WoT producer.\\n'}, {'type': 'paragraph', 'segments': [{'id': 'td-form-context-submission-target', 'text': 'As a Form but not just the `href` defines how to execute the interaction, `href` of multiple Forms *MAY* point to the same resource, where the different Forms represent different operations on that resource.\\n'}, {'text': 'For example, in a TD with the HTTP Binding, two Forms with HTTP GET and PUT methods can point to the same resource but represent different operations such as `readproperty` and `writeproperty`.\\n'}]}]" ;
    td:spec_description "A form can be viewed as a statement of \"To perform an **operation type** operation on **form context**, make a **request method** request to **submission target**\" where the optional **form fields** may further describe the required request.  In Thing Descriptions, the **form context** is the surrounding Object, such as Properties, Actions, and Events or the Thing itself for meta-interactions." .

hctl:Link a owl:Class ;
    rdfs:label "Link" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:hreflang ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hctl:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:anchor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:anchor ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( [ a rdfs:Datatype ;
                                owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                            owl:datatypeComplementOf xsd:string ] ) ] [ a rdfs:Datatype ;
                                owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                            owl:datatypeComplementOf xsd:string ] ) ] ) ] ;
            owl:onProperty hctl:hreflang ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:sizes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:hreflang ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hctl:anchor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:sizes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hctl:href ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:href ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hctl:rel ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^(\\d+x\\d+)(\\s+\\d+x\\d+)*$" ] ) ] ) ] ;
            owl:onProperty hctl:sizes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hctl:rel ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hctl:rel ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hctl:href ] ;
    skos:definition "A link can be viewed as a statement of the form \"**_link context_** has a **_relation type_** resource at **_link target_**\", where the optional **_target attributes_** may further describe the resource." ;
    skos:exactMatch hctl:Link ;
    skos:inScheme hctl: ;
    td:spec_content "[{'type': 'note', 'text': 'The hreflang attribute is allowed to be a `string` or `array` in this version of the spec. Depending on the result of [[LINKSET-MEDIA-TYPES]] the values of `hrefLang` can be restricted to `array` only.\\n'}, {'type': 'markdown', 'text': 'Link relations can be used to describe relations such as to other Things (e.g., a Switch Thing controls a Lamp Thing), to a specific kind of Thing Models (e.g., a Thing Description is an instance of a specific Thing Model), or to further documentations information (e.g., device manual of a Thing). It is recommended to reuse existing and established Link Relation definitions from IANA.\\n\\nThe link relation types follow Web Linking [[RFC8288]], meaning:\\n'}, {'type': 'list', 'items': [{'id': 'td-rel-type-case-insensitive', 'text': 'Relation types *MUST* be compared as strings using case-insensitive comparison.\\n'}, {'id': 'td-rel-type-lowercase', 'text': 'All-lowercase URIs *SHOULD* be used for extension relation types.\\n'}]}, {'type': 'markdown', 'text': 'In the following a best practice relation type table is introduced that is recommended to use within WoT Thing Description or Thing Model instances.\\n'}, {'type': 'enum_table', 'enum': 'LinkRelationType', 'caption': 'Best practice relation type table', 'table_id': 'table-rel-type', 'columns': [{'field': 'name', 'header': 'Value'}, {'field': 'comment:Occurrence', 'header': 'Occurrence'}, {'field': 'description', 'header': 'Explanation'}, {'field': 'comment:Source', 'header': 'Source of value origin'}]}]" ;
    td:spec_description "A link can be viewed as a statement of the form **\"link context** has a **relation type** resource at **link target**\", where the optional **target attributes** may further describe the resource." .

hctl:rel a owl:DatatypeProperty ;
    rdfs:label "rel" ;
    skos:definition "A link relation type identifies the semantics of a link." ;
    skos:inScheme hctl: ;
    skos:note "Recommended to use IANA Link Relations when possible" .

hctl:sizes a owl:DatatypeProperty ;
    rdfs:label "sizes" ;
    skos:definition "Target attribute that specifies one or more sizes for the referenced icon. Only applicable for relation  type \"icon\". The value pattern follows {Height}x{Width} (e.g., \"16x16\", \"16x16 32x32\")." ;
    skos:inScheme hctl: .

td:ActionAffordance a owl:Class ;
    rdfs:label "ActionAffordance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:idempotent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty td:synchronous ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty td:safe ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:input ],
        [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:DataSchema ;
            owl:onProperty td:input ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:input ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:safe ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:synchronous ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:output ],
        [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:DataSchema ;
            owl:onProperty td:output ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty td:idempotent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:safe ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:output ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:synchronous ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:idempotent ],
        td:InteractionAffordance ;
    skos:definition "An Interaction Affordance that allows to invoke a function of the Thing, which manipulates state (e.g., toggling a lamp on or off) or triggers a process on the Thing (e.g., dim a lamp over time)." ;
    skos:exactMatch td:ActionAffordance ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_content "[{'type': 'paragraph', 'segments': [{'text': '`ActionAffordance` is a Subclass of the `InteractionAffordance` Class.\\n'}, {'id': 'td-op-for-action', 'text': 'When a Form instance is within an `ActionAffordance` instance, the value assigned to `op` *MUST* either be `invokeaction`, `queryaction`, `cancelaction`, or an Array containing a combination of these terms.\\n'}]}]" .

td:AlgList a owl:Class ;
    rdfs:label "algList" ;
    owl:unionOf ( <https://www.w3.org/2019/wot/td#AlgList#ES256> <https://www.w3.org/2019/wot/td#AlgList#ES512-256> ) ;
    skos:definition "Examples of encoding, encryption, or digest algorithms for bearer tokens." ;
    skos:inScheme wotsec: ;
    linkml:permissible_values <https://www.w3.org/2019/wot/td#AlgList#ES256>,
        <https://www.w3.org/2019/wot/td#AlgList#ES512-256> .

td:EventAffordance a owl:Class ;
    rdfs:label "EventAffordance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:DataSchema ;
            owl:onProperty td:subscription ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:dataResponse ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:cancellation ],
        [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:DataSchema ;
            owl:onProperty td:cancellation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:data ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:subscription ],
        [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:DataSchema ;
            owl:onProperty td:dataResponse ],
        [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:DataSchema ;
            owl:onProperty td:data ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:subscription ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:data ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:dataResponse ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:cancellation ],
        td:InteractionAffordance ;
    skos:definition "An Interaction Affordance that describes an event source, which asynchronously pushes event data to Consumers (e.g., overheating alerts)." ;
    skos:exactMatch td:EventAffordance ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_content "[{'type': 'paragraph', 'segments': [{'text': '`EventAffordance` is a Subclass of the `InteractionAffordance` Class.\\n'}, {'id': 'td-op-for-event', 'text': 'When a Form instance is within an EventAffordance instance, the value assigned to `op` *MUST* be either `subscribeevent`, `unsubscribeevent`, or both terms within an Array.\\n'}]}, {'type': 'note', 'text': 'It is considered to be good practice that each `subscribeevent` has a corresponding `unsubscribeevent` unless the protocol supports implicit unsubscription mechanisms (e.g., heartbeat to detect connection loss).\\n'}, {'type': 'paragraph', 'segments': [{'text': 'EventAffordances are similar to observable PropertyAffordances in the sense that the Thing itself informs interested Consumers about state changes. However, a main difference of EventAffordances is that not every change of the associated resource needs to trigger an !event message to be emitted, e.g., a critical threshold for a numeric value.\\n'}, {'id': 'td-event-trigger', 'text': 'Events MAY be triggered through conditions that are not exposed as Properties.\\n'}, {'text': 'Furthermore, EventAffordances allow for more complex subscribing and unsubscribing mechanisms via the definition of subscription, dataResponse, and cancellation DataSchema definitions. Not all protocols might support these more advanced mechanisms, however, which is why in some scenarios, events may be very similar to observable PropertyAffordances. In these cases, the choice between a Property and a Event for modelling the Affordance should be made based on the semantics of the underlying resource; for example, if the state of the affordance is also supposed to be read or written by a Consumer, then a Property is most likely the appropriate choice.\\n'}]}]" .

td:OAuth2Flow a owl:Class ;
    rdfs:label "OAuth2Flow" ;
    owl:unionOf ( <https://www.w3.org/2019/wot/td#OAuth2Flow#code> <https://www.w3.org/2019/wot/td#OAuth2Flow#client> ) ;
    skos:definition "OAuth 2.0 authorization flows" ;
    skos:inScheme wotsec: ;
    linkml:permissible_values <https://www.w3.org/2019/wot/td#OAuth2Flow#client>,
        <https://www.w3.org/2019/wot/td#OAuth2Flow#code> .

td:PropertyAffordance a owl:Class ;
    rdfs:label "PropertyAffordance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:observable ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:observable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty td:observable ],
        jsonschema:DataSchema,
        td:InteractionAffordance ;
    skos:definition "An Interaction Affordance that exposes state of the Thing. This state can be retrieved (read) and/or updated (write). Things can also choose to make Properties observable by pushing the new state after a change." ;
    skos:exactMatch td:PropertyAffordance ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_content "[{'type': 'note', 'text': 'Property instances are also instances of the class DataSchema. Therefore, it can contain the `type`, `unit`, `readOnly` and `writeOnly` members, among others.\\n'}, {'type': 'paragraph', 'segments': [{'text': '`PropertyAffordance` is a Subclass of the `InteractionAffordance` Class and the DataSchema Class.\\n'}, {'id': 'td-op-for-property', 'text': 'When a Form instance is within a `PropertyAffordance` instance, the value assigned to `op` MUST be one of `readproperty`, `writeproperty`, `observeproperty`, `unobserveproperty` or an Array containing a combination of these terms.\\n'}]}, {'type': 'note', 'text': 'It is considered to be good practice that each `observeproperty` has a corresponding `unobserveproperty` unless the protocol supports implicit unsubscription mechanisms (e.g., heartbeat to detect connection loss).\\n'}, {'type': 'note', 'text': 'The observation mechanism depends on the underlying protocol or sub-protocol. Having said that, it is not guaranteed that the current Property value will be provided once the subscription is initiated. Hence, it may be necessary to read the current Property value before/after the subscription to get a first value.\\n'}]" .

td:QoPType a owl:Class ;
    rdfs:label "QoPType" ;
    owl:unionOf ( <https://www.w3.org/2019/wot/td#QoPType#auth> <https://www.w3.org/2019/wot/td#QoPType#auth-int> ) ;
    skos:definition "Quality of protection options for digest security" ;
    skos:inScheme wotsec: ;
    linkml:permissible_values <https://www.w3.org/2019/wot/td#QoPType#auth>,
        <https://www.w3.org/2019/wot/td#QoPType#auth-int> .

td:SubprotocolList a owl:Class ;
    rdfs:label "SubprotocolList" ;
    owl:unionOf ( <https://www.w3.org/2019/wot/td#SubprotocolList#longpoll> <https://www.w3.org/2019/wot/td#SubprotocolList#websub> <https://www.w3.org/2019/wot/td#SubprotocolList#sse> ) ;
    skos:inScheme hctl: ;
    linkml:permissible_values <https://www.w3.org/2019/wot/td#SubprotocolList#longpoll>,
        <https://www.w3.org/2019/wot/td#SubprotocolList#sse>,
        <https://www.w3.org/2019/wot/td#SubprotocolList#websub> .

td:forms a owl:ObjectProperty ;
    rdfs:label "forms" ;
    rdfs:range hctl:Form ;
    skos:definition "Set of form hypermedia controls that describe how an operation can be performed. Forms are serializations of Protocol Bindings. The array cannot be empty." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_description "Set of form hypermedia controls that describe how an operation can be performed. Forms are serializations of Protocol Bindings. [Thing level](#dfn-td-thing-level) forms are used to describe endpoints for a group of interaction affordances." .

td:properties a owl:ObjectProperty ;
    rdfs:label "properties" ;
    rdfs:range td:PropertyAffordance ;
    rdfs:subPropertyOf td:hasInteractionAffordance ;
    skos:definition "All Property-based Interaction Affordances of the Thing." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:jsonld_index "td:name" .

td:uriVariables a owl:ObjectProperty ;
    rdfs:label "uriVariables" ;
    rdfs:range jsonschema:DataSchema ;
    skos:definition "Define URI template variables according to RFC6570 as collection based on schema specifications. The individual variables DataSchema cannot be an ObjectSchema or an ArraySchema." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:jsonld_index "td:name" ;
    td:spec_description "Define URI template variables according to [[RFC6570]] as collection based on DataSchema declarations. The Thing level `uriVariables` can be used in Thing level forms or in Interaction Affordances. The individual variables DataSchema cannot be an ObjectSchema or an ArraySchema since each variable needs to be serialized to a string inside the `href` upon the execution of the operation. If the same variable is both declared in Thing level `uriVariables` and in Interaction Affordance level, the Interaction Affordance level variable takes precedence." .

td:BearerFormat a owl:Class ;
    rdfs:label "BearerFormat" ;
    owl:unionOf ( <https://www.w3.org/2019/wot/td#BearerFormat#jwt> <https://www.w3.org/2019/wot/td#BearerFormat#jws> <https://www.w3.org/2019/wot/td#BearerFormat#cwt> <https://www.w3.org/2019/wot/td#BearerFormat#jwe> ) ;
    skos:definition "Format specifications for bearer tokens" ;
    skos:inScheme wotsec: ;
    linkml:permissible_values <https://www.w3.org/2019/wot/td#BearerFormat#cwt>,
        <https://www.w3.org/2019/wot/td#BearerFormat#jwe>,
        <https://www.w3.org/2019/wot/td#BearerFormat#jws>,
        <https://www.w3.org/2019/wot/td#BearerFormat#jwt> .

td:InteractionAffordance a owl:Class ;
    rdfs:label "InteractionAffordance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom hctl:Form ;
            owl:onProperty td:forms ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:MultiLanguage ;
            owl:onProperty td:titles ],
        [ owl:unionOf ( td:ActionAffordance td:EventAffordance td:PropertyAffordance ) ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:atType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:uriVariables ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty td:forms ],
        [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:DataSchema ;
            owl:onProperty td:uriVariables ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ owl:unionOf ( [ owl:intersectionOf ( xsd:string [ owl:complementOf xsd:string ] ) ] [ owl:intersectionOf ( xsd:string [ owl:complementOf xsd:string ] ) ] ) ] xsd:string ) ] ;
            owl:onProperty td:atType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty td:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:atType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:descriptions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty td:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:titles ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty td:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty td:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:MultiLanguage ;
            owl:onProperty td:descriptions ] ;
    skos:definition "Metadata of a Thing that shows the possible choices to Consumers, thereby suggesting how Consumers may interact with the Thing. There are many types of potential affordances, but W3C WoT defines three types of Interaction Affordances: Properties, Actions, and Events." ;
    skos:exactMatch td:InteractionAffordance ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_content "[{'type': 'markdown', 'text': 'The !class `InteractionAffordance` has the following subclasses:\\n\\n- PropertyAffordance\\n- ActionAffordance\\n- EventAffordance\\n'}]" .

xsd:nonNegativeInteger a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:integer ;
            owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] .

hctl:href a owl:DatatypeProperty ;
    rdfs:label "href" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Target URI of a submission target of a Form. See the note on URI/IRI." ;
    skos:inScheme hctl: .

jsonschema:exclusiveMaximum a owl:DatatypeProperty ;
    rdfs:label "exclusiveMaximum" ;
    rdfs:range xsd:decimal ;
    skos:definition "Specifies a maximum numeric value, representing an exclusive upper limit. Only applicable for associated number or integer types." ;
    skos:inScheme jsonschema: .

jsonschema:exclusiveMinimum a owl:DatatypeProperty ;
    rdfs:label "exclusiveMinimum" ;
    rdfs:range xsd:decimal ;
    skos:definition "Specifies a minimum numeric value, representing an exclusive lower limit. Only applicable for associated number or integer types." ;
    skos:inScheme jsonschema: .

jsonschema:maximum a owl:DatatypeProperty ;
    rdfs:label "maximum" ;
    rdfs:range xsd:decimal ;
    skos:definition "Specifies a maximum numeric value, representing an inclusive upper limit. Only applicable for associated number or integer types." ;
    skos:inScheme jsonschema: .

jsonschema:minimum a owl:DatatypeProperty ;
    rdfs:label "minimum" ;
    rdfs:range xsd:decimal ;
    skos:definition "Specifies a minimum numeric value, representing an inclusive lower limit. Only applicable for associated number or integer types." ;
    skos:inScheme jsonschema: .

jsonschema:multipleOf a owl:DatatypeProperty ;
    rdfs:label "multipleOf" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ a rdfs:Datatype ;
                        owl:datatypeComplementOf [ a rdfs:Datatype ;
                                owl:intersectionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:integer ;
                                            owl:withRestrictions ( [ xsd:maxInclusive 0 ] ) ] ) ] ] xsd:decimal [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
    skos:definition "Specifies the multipleOf value number. The value must strictly greater than 0. Only applicable for associated number or integer types." ;
    skos:inScheme jsonschema: .

wotsec:authorization a owl:DatatypeProperty ;
    rdfs:label "authorization" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URI of the authorization server." ;
    skos:inScheme wotsec: .

wotsec:scopes a owl:DatatypeProperty ;
    rdfs:label "scopes" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:string xsd:string ) ] ;
    skos:definition "Set of authorization scope identifiers provided as an array. These are provided in tokens returned by an  authorization server and associated with forms in order to identify what resources a client may access and how." ;
    skos:inScheme wotsec: ;
    skos:note "This feature is at risk." ;
    td:spec_description "Set of authorization scope identifiers provided as an array.  These are provided in tokens returned by an authorization server and associated with forms in order to identify what resources  a client may access and how. The values associated with a form SHOULD be chosen from those defined in an `OAuth2SecurityScheme` active on that form." .

td:security a owl:ObjectProperty ;
    rdfs:label "security" ;
    skos:definition "A security configuration is a security scheme applied to a (set of) affordance(s)." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_description "Set of security definition names, chosen from those defined in `securityDefinitions`. These must all be satisfied for access to resources." .

td:titles a owl:ObjectProperty ;
    rdfs:label "titles" ;
    rdfs:range td:MultiLanguage ;
    skos:definition "Title of the TD element (Thing, interaction affordance or data schema) with language tag. By convention, a language tag must be added to the object of 'titleInLanguage' triples. Otherwise, use 'title'." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_description "Provides multi-language human-readable titles (e.g., display a text for UI representation in different languages). Also see [=MultiLanguage=]." .

td:ContentEncodingList a owl:Class ;
    rdfs:label "contentEncodingList" ;
    owl:unionOf ( <https://www.w3.org/2019/wot/td#ContentEncodingList#7bit> <https://www.w3.org/2019/wot/td#ContentEncodingList#8bit> <https://www.w3.org/2019/wot/td#ContentEncodingList#binary> <https://www.w3.org/2019/wot/td#ContentEncodingList#quoted-printable> <https://www.w3.org/2019/wot/td#ContentEncodingList#base16> <https://www.w3.org/2019/wot/td#ContentEncodingList#base32> <https://www.w3.org/2019/wot/td#ContentEncodingList#base64> ) ;
    skos:definition "Specifies the encoding used to store the contents." ;
    skos:inScheme jsonschema: ;
    linkml:permissible_values <https://www.w3.org/2019/wot/td#ContentEncodingList#7bit>,
        <https://www.w3.org/2019/wot/td#ContentEncodingList#8bit>,
        <https://www.w3.org/2019/wot/td#ContentEncodingList#base16>,
        <https://www.w3.org/2019/wot/td#ContentEncodingList#base32>,
        <https://www.w3.org/2019/wot/td#ContentEncodingList#base64>,
        <https://www.w3.org/2019/wot/td#ContentEncodingList#binary>,
        <https://www.w3.org/2019/wot/td#ContentEncodingList#quoted-printable> .

td:descriptions a owl:ObjectProperty ;
    rdfs:label "descriptions" ;
    rdfs:range td:MultiLanguage ;
    skos:definition "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_description "Can be used to support (human-readable) information in different languages. Also see [=MultiLanguage=]." .

hctl:contentType a owl:DatatypeProperty ;
    rdfs:label "contentType" ;
    rdfs:range xsd:string ;
    skos:definition "Assign a content type based on a media type (e.g., text/plain) and potential parameters  (e.g., charset=utf-8) for the media type [RFC2046].",
        "Assign a content type based on a media type (e.g., text/plain) and potential parameters (e.g., charset=utf-8) for the media type [RFC2046]." ;
    skos:inScheme hctl: ;
    td:spec_description "Assign a content type based on a media type (e.g., `text/plain`) and potential parameters (e.g., `charset=utf-8`) for the media type [[RFC2046]]." .

td:MultiLanguage a owl:Class ;
    rdfs:label "MultiLanguage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:language_tag ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty td:language_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[a-zA-Z]{2,3}(-[a-zA-Z]{3}(-[a-zA-Z]{3}){0,2})?$" ] ) ] ) ] ;
            owl:onProperty td:language_tag ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty td:language_tag ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:language_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty td:language_value ] ;
    skos:definition "A Map providing a set of human-readable texts in different languages identified by language tags as defined in BCP47." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_content "[{'type': 'paragraph', 'segments': [{'id': 'td-multilanguage-language-tag', 'text': 'Each name of the `MultiLanguage` Map *MUST* be a language tag as defined in [[!BCP47]].\\n'}, {'id': 'td-multilanguage-value', 'text': 'Each value of the `MultiLanguage` Map *MUST* be of type string.\\n'}]}]" ;
    td:spec_description "A Map providing a set of human-readable texts in different languages identified by language tags as defined in [[BCP47]]. See [6.3.2 Human-Readable Metadata](#titles-descriptions-serialization-json) for example usages of this container in a Thing Description instance." .

td:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:range xsd:string ;
    skos:definition "Title of the TD element (Thing, interaction affordance or data schema)." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_description "Provides a human-readable title (e.g., display a text for UI representation) based on a default language." .

xsd:decimal a rdfs:Datatype .

jsonschema:Any a owl:Class ;
    rdfs:label "Any" ;
    skos:exactMatch linkml:Any ;
    skos:inScheme jsonschema: ;
    td:spec_exclude true .

td:SecurityLocationType a owl:Class ;
    rdfs:label "SecurityLocationType" ;
    owl:unionOf ( <https://www.w3.org/2019/wot/td#SecurityLocationType#header> <https://www.w3.org/2019/wot/td#SecurityLocationType#query> <https://www.w3.org/2019/wot/td#SecurityLocationType#body> <https://www.w3.org/2019/wot/td#SecurityLocationType#cookie> <https://www.w3.org/2019/wot/td#SecurityLocationType#uri> <https://www.w3.org/2019/wot/td#SecurityLocationType#auto> ) ;
    skos:definition "Specifies the location where security authentication information should be provided" ;
    skos:inScheme wotsec: ;
    linkml:permissible_values <https://www.w3.org/2019/wot/td#SecurityLocationType#auto>,
        <https://www.w3.org/2019/wot/td#SecurityLocationType#body>,
        <https://www.w3.org/2019/wot/td#SecurityLocationType#cookie>,
        <https://www.w3.org/2019/wot/td#SecurityLocationType#header>,
        <https://www.w3.org/2019/wot/td#SecurityLocationType#query>,
        <https://www.w3.org/2019/wot/td#SecurityLocationType#uri> .

td:SecuritySchemeList a owl:Class ;
    rdfs:label "SecuritySchemeList" ;
    owl:unionOf ( <https://www.w3.org/2019/wot/td#SecuritySchemeList#nosec> <https://www.w3.org/2019/wot/td#SecuritySchemeList#combo> <https://www.w3.org/2019/wot/td#SecuritySchemeList#basic> <https://www.w3.org/2019/wot/td#SecuritySchemeList#digest> <https://www.w3.org/2019/wot/td#SecuritySchemeList#bearer> <https://www.w3.org/2019/wot/td#SecuritySchemeList#psk> <https://www.w3.org/2019/wot/td#SecuritySchemeList#oauth2> <https://www.w3.org/2019/wot/td#SecuritySchemeList#apikey> <https://www.w3.org/2019/wot/td#SecuritySchemeList#auto> ) ;
    skos:definition "Identification of the security mechanism being configured." ;
    skos:inScheme wotsec: ;
    linkml:permissible_values <https://www.w3.org/2019/wot/td#SecuritySchemeList#apikey>,
        <https://www.w3.org/2019/wot/td#SecuritySchemeList#auto>,
        <https://www.w3.org/2019/wot/td#SecuritySchemeList#basic>,
        <https://www.w3.org/2019/wot/td#SecuritySchemeList#bearer>,
        <https://www.w3.org/2019/wot/td#SecuritySchemeList#combo>,
        <https://www.w3.org/2019/wot/td#SecuritySchemeList#digest>,
        <https://www.w3.org/2019/wot/td#SecuritySchemeList#nosec>,
        <https://www.w3.org/2019/wot/td#SecuritySchemeList#oauth2>,
        <https://www.w3.org/2019/wot/td#SecuritySchemeList#psk> .

<https://www.w3.org/2019/wot/security#@name> a owl:DatatypeProperty ;
    rdfs:label "@name" ;
    rdfs:range xsd:string ;
    skos:definition "Name for query, header, cookie, or uri parameters. When used with body location, must be a JSON pointer." ;
    skos:inScheme wotsec: ;
    skos:prefLabel "name" ;
    td:spec_description "Name for query, header, cookie, or uri parameters." .

wotsec:SecurityScheme a owl:Class ;
    rdfs:label "SecurityScheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty td:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:MultiLanguage ;
            owl:onProperty td:descriptions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:description ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty wotsec:security_scheme_key ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:descriptions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:proxy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:security_scheme_key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:atType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:atType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty wotsec:proxy ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:SecuritySchemeList ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:proxy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty wotsec:security_scheme_key ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ owl:unionOf ( [ owl:intersectionOf ( xsd:string [ owl:complementOf xsd:string ] ) ] [ owl:intersectionOf ( xsd:string [ owl:complementOf xsd:string ] ) ] ) ] xsd:string ) ] ;
            owl:onProperty td:atType ] ;
    skos:definition "Metadata describing the configuration of a security mechanism. The value assigned to the name scheme MUST be defined  within a Vocabulary included in the Thing Description. For all security schemes, any keys, passwords, or other  sensitive information directly providing access MUST NOT be stored in the TD and should instead be shared and  stored out-of-band via other mechanisms." ;
    skos:exactMatch wotsec:SecurityScheme ;
    skos:inScheme wotsec: ;
    td:jsonschema_oneof_dispatch "JsonObj(discriminator='scheme', include_unknown=True)" ;
    td:spec_content "[{'type': 'markdown', 'text': 'The !class SecurityScheme has the following subclasses:\\n\\n- NoSecurityScheme\\n- AutoSecurityScheme\\n- ComboSecurityScheme\\n- BasicSecurityScheme\\n- DigestSecurityScheme\\n- APIKeySecurityScheme\\n- BearerSecurityScheme\\n- PSKSecurityScheme\\n- OAuth2SecurityScheme\\n'}]" ;
    td:spec_intro_content "[{'type': 'paragraph', 'segments': [{'text': 'Metadata describing the configuration of a security mechanism.\\n'}, {'id': 'td-security-scheme-name', 'text': 'The value assigned to the name `scheme` MUST be defined within a Vocabulary included in the Thing Description, either in the standard Vocabulary defined in [TD Information Model](#sec-vocabulary-definition) or in a [TD Context Extension](#sec-vocabulary-definition).\\n'}]}, {'type': 'paragraph', 'segments': [{'id': 'td-security-no-secrets', 'text': 'For all security schemes, any keys, passwords, or other sensitive information directly providing access *MUST NOT* be stored in the TD and should instead be shared and stored out-of-band via other mechanisms.\\n'}, {'text': 'The purpose of a TD is to describe how to access a Thing if and only if a Consumer already has authorization, and is not meant be used to grant that authorization.\\n'}]}, {'type': 'markdown', 'text': 'Each security scheme object used in a TD defines a set of requirements to be met before access can be granted. We say a security scheme is *satisfied* when all its requirements are met. In some cases requirements from multiple security schemes will have to be met before access can be granted.\\n\\nSecurity schemes generally may require additional authentication parameters, such as a password or key. The location of this information is indicated by the value associated with the name `in`, often in combination with the value associated with `name`. The value associated with `in` can take one of the following values:\\n\\n**header**:\\nThe parameter will be given in a header provided by the protocol, with the name of the header provided by the value of name.\\n\\n**query**:\\nThe parameter will be appended to the URI as a query parameter, with the name of the query parameter provided by name.\\n'}, {'type': 'paragraph', 'segments': [{'text': '**body**: The parameter will be provided in the body of the request payload, with the data schema element used provided by *name*.\\n'}, {'id': 'td-security-body-name-json-pointer', 'text': 'When used in the context of a *body* security information location, the value of name *MUST* be in the form of a JSON pointer [[!RFC6901]] relative to the root of the input `DataSchema` for each interaction it is used with.\\n'}, {'text': 'Since this value is not a fragment identifier, and is not relative to the root of the TD but to whichever data schemas the security scheme is bound to, this value should not start with #; it is a \"pure\" JSON pointer. Since this value is not a fragment identifier, it also does not need to URL-encode special characters. The targeted element may or may not already exist at the specified location in the referenced object or array schema (consequently the mechanism is not applicable to simple types). If it does not, it will be inserted. This avoids having to duplicate definitions in the data schemas of every interaction.\\n'}, {'id': 'td-security-body-name-json-pointer-creatable', 'text': 'When an element of a data schema indicated by a JSON pointer indicated in a body locator does not already exist in the indicated schema, it *MUST* be possible to insert the indicated element at the location indicated by the pointer.\\n'}, {'id': 'td-security-body-name-json-pointer-array', 'text': 'The JSON pointer used in the body locator *MAY* use the \"-\" character to indicate a non-existent array element when it is necessary to insert an element after the last element of an existing array.\\n'}, {'id': 'td-security-body-name-json-pointer-type', 'text': 'The element referenced (or created) by a `body` security information location *MUST* be required and of type \"string\".\\n'}, {'text': 'If name is not given, it is assumed the entire body is to be used as the security parameter.\\n'}]}, {'type': 'markdown', 'text': '**cookie**:\\nThe parameter is stored in a cookie identified by the value of name.\\n'}, {'type': 'paragraph', 'segments': [{'text': '**uri**: The parameter is embedded in the URI itself, which is encoded in the relevant interaction using a URI template variable defined by the value of name. This is more general than the query mechanism but more complex.\\n'}, {'id': 'td-security-in-query-over-uri', 'text': 'The value uri *SHOULD* be specified for the name in in a security scheme only if query is not applicable.\\n'}, {'id': 'td-security-in-uri-variable', 'text': 'The URIs provided in interactions where a security scheme using uri as the value for in *MUST* be a URI template including the defined variable.\\n'}]}, {'type': 'paragraph', 'segments': [{'text': '**auto**: The location is determined as part of the protocol, or negotiated.\\n'}, {'id': 'td-security-security-vocab-auto-in-no-name', 'text': 'If a value of `auto` is set for the `in` field of a `SecurityScheme`, then the name field *SHOULD NOT* be set.\\n'}, {'text': 'In this case, the application of the `SecurityScheme` is subject to the respective specification for the given protocol (e.g. [[RFC7617]] when using the `BasicSecurityScheme` with HTTP).\\n'}]}, {'type': 'markdown', 'text': 'If multiple parameters are needed for a security scheme, repeat the security scheme definition for each parameter and combine them using a combo security scheme and `allOf`. In some cases parameters may not actually be secret but a user may wish to leave them out of the TD to help protect privacy. As an example of this, some security mechanisms require both a client identifier and a secret key. In theory, the client identifier is public however it may be hard to update and pose a tracking risk. In such a case it can be provided as an additional security parameter so it does not appear in the TD.\\n'}, {'type': 'assertion', 'id': 'td-security-uri-variables-distinct', 'text': 'The names of URI variables declared in a `SecurityScheme` *MUST* be distinct from all other URI variables declared in the TD.\\n'}]" .

wotsec:in a owl:ObjectProperty ;
    rdfs:label "in" ;
    rdfs:range td:SecurityLocationType ;
    skos:definition "Specifies the location of security authentication information." ;
    skos:inScheme wotsec: ;
    skos:note "Default value should be provided by implementations",
        "The API Key security scheme maps the JSON member `in` to `wotsec:apikeyIn`, while Basic, Digest, and Bearer schemes map it to `wotsec:in`." .

td:LinkRelationType a owl:Class ;
    rdfs:label "LinkRelationType" ;
    owl:unionOf ( <https://www.w3.org/2019/wot/td#LinkRelationType#icon> <https://www.w3.org/2019/wot/td#LinkRelationType#service-doc> <https://www.w3.org/2019/wot/td#LinkRelationType#alternate> <https://www.w3.org/2019/wot/td#LinkRelationType#type> <https://www.w3.org/2019/wot/td#LinkRelationType#tm%3Aextends> <https://www.w3.org/2019/wot/td#LinkRelationType#tm%3Asubmodel> <https://www.w3.org/2019/wot/td#LinkRelationType#manifest> <https://www.w3.org/2019/wot/td#LinkRelationType#proxy-to> <https://www.w3.org/2019/wot/td#LinkRelationType#collection> <https://www.w3.org/2019/wot/td#LinkRelationType#item> <https://www.w3.org/2019/wot/td#LinkRelationType#predecessor-version> <https://www.w3.org/2019/wot/td#LinkRelationType#controlledBy> ) ;
    skos:definition "Best practice relation type values recommended for use within WoT Thing Description or Thing Model instances." ;
    skos:inScheme hctl: ;
    linkml:permissible_values <https://www.w3.org/2019/wot/td#LinkRelationType#alternate>,
        <https://www.w3.org/2019/wot/td#LinkRelationType#collection>,
        <https://www.w3.org/2019/wot/td#LinkRelationType#controlledBy>,
        <https://www.w3.org/2019/wot/td#LinkRelationType#icon>,
        <https://www.w3.org/2019/wot/td#LinkRelationType#item>,
        <https://www.w3.org/2019/wot/td#LinkRelationType#manifest>,
        <https://www.w3.org/2019/wot/td#LinkRelationType#predecessor-version>,
        <https://www.w3.org/2019/wot/td#LinkRelationType#proxy-to>,
        <https://www.w3.org/2019/wot/td#LinkRelationType#service-doc>,
        <https://www.w3.org/2019/wot/td#LinkRelationType#tm%3Aextends>,
        <https://www.w3.org/2019/wot/td#LinkRelationType#tm%3Asubmodel>,
        <https://www.w3.org/2019/wot/td#LinkRelationType#type> .

td:atType a owl:DatatypeProperty ;
    rdfs:label "atType" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ owl:unionOf ( [ a rdfs:Datatype ;
                                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                                owl:datatypeComplementOf xsd:string ] ) ] [ a rdfs:Datatype ;
                                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                                owl:datatypeComplementOf xsd:string ] ) ] ) ] xsd:string ) ] ;
    skos:definition "JSON-LD keyword to label the object with semantic tags (or types)." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    skos:prefLabel "@type" .

td:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:definition "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_description "Provides additional (human-readable) information based on a default language." .

linkml:uri a owl:Class ;
    rdfs:label "DataSchemaType",
        "ThingContextUri" ;
    owl:unionOf ( <https://w3id.org/linkml/uri#https%3A%2F%2Fwww.w3.org%2F2019%2Fwot%2Ftd%2Fv1> <https://w3id.org/linkml/uri#https%3A%2F%2Fwww.w3.org%2F2022%2Fwot%2Ftd%2Fv1.1> <https://w3id.org/linkml/uri#https%3A%2F%2Fwww.w3.org%2Fns%2Fwot-next%2Ftd> ),
        ( <https://w3id.org/linkml/uri#object> <https://w3id.org/linkml/uri#array> <https://w3id.org/linkml/uri#string> <https://w3id.org/linkml/uri#number> <https://w3id.org/linkml/uri#integer> <https://w3id.org/linkml/uri#boolean> <https://w3id.org/linkml/uri#null> ) ;
    skos:definition "Assignment of JSON-based data types compatible with JSON Schema",
        "Valid W3C WoT Thing Description context URIs." ;
    skos:inScheme jsonschema:,
        <https://www.w3.org/2019/wot/td> ;
    linkml:permissible_values <https://w3id.org/linkml/uri#array>,
        <https://w3id.org/linkml/uri#boolean>,
        <https://w3id.org/linkml/uri#https%3A%2F%2Fwww.w3.org%2F2019%2Fwot%2Ftd%2Fv1>,
        <https://w3id.org/linkml/uri#https%3A%2F%2Fwww.w3.org%2F2022%2Fwot%2Ftd%2Fv1.1>,
        <https://w3id.org/linkml/uri#https%3A%2F%2Fwww.w3.org%2Fns%2Fwot-next%2Ftd>,
        <https://w3id.org/linkml/uri#integer>,
        <https://w3id.org/linkml/uri#null>,
        <https://w3id.org/linkml/uri#number>,
        <https://w3id.org/linkml/uri#object>,
        <https://w3id.org/linkml/uri#string> .

td:OperationType a owl:Class ;
    rdfs:label "OperationType" ;
    owl:unionOf ( td:readProperty td:writeProperty td:observeProperty td:unobserveProperty td:invokeAction td:queryAction td:cancelAction td:subscribeEvent td:unsubscribeEvent td:readAllProperties td:writeAllProperties td:readMultipleProperties td:writeMultipleProperties td:observeAllProperties td:unobserveAllProperties td:queryAllActions td:subscribeAllEvents td:unsubscribeAllEvents ) ;
    skos:definition "Well-known operation types for WoT interaction model. The list of possible operation types of a form is fixed. As of this version of the specification, it only includes the well-known types necessary to implement the WoT interaction model." ;
    skos:inScheme hctl: ;
    skos:note "Consumer to Thing applies for messages sent by the Consumer to the Thing",
        "No correlation implies no payload is required or expected",
        "Thing to Consumer applies for messages sent by the Thing to the Consumer" ;
    linkml:permissible_values td:cancelAction,
        td:invokeAction,
        td:observeAllProperties,
        td:observeProperty,
        td:queryAction,
        td:queryAllActions,
        td:readAllProperties,
        td:readMultipleProperties,
        td:readProperty,
        td:subscribeAllEvents,
        td:subscribeEvent,
        td:unobserveAllProperties,
        td:unobserveProperty,
        td:unsubscribeAllEvents,
        td:unsubscribeEvent,
        td:writeAllProperties,
        td:writeMultipleProperties,
        td:writeProperty .

jsonschema:DataSchema a owl:Class ;
    rdfs:label "DataSchema" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:atType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:oneOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty td:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:default ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:default ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:enum ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jsonschema:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:Any ;
            owl:onProperty jsonschema:default ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty jsonschema:writeOnly ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:MultiLanguage ;
            owl:onProperty td:titles ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:format ],
        [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:Any ;
            owl:onProperty jsonschema:enum ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:descriptions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:const ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:readOnly ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jsonschema:format ],
        [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:DataSchema ;
            owl:onProperty jsonschema:allOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:format ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ owl:unionOf ( [ owl:intersectionOf ( xsd:string [ owl:complementOf xsd:string ] ) ] [ owl:intersectionOf ( xsd:string [ owl:complementOf xsd:string ] ) ] ) ] xsd:string ) ] ;
            owl:onProperty td:atType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:writeOnly ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:atType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty td:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:readOnly ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jsonschema:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty jsonschema:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:uri ;
            owl:onProperty jsonschema:type ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:MultiLanguage ;
            owl:onProperty td:descriptions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:writeOnly ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty jsonschema:readOnly ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:allOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:DataSchema ;
            owl:onProperty jsonschema:oneOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:Any ;
            owl:onProperty jsonschema:const ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:titles ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:const ] ;
    skos:definition "A data schema describes the data format used. It can be used for validation." ;
    skos:exactMatch jsonschema:DataSchema ;
    skos:inScheme jsonschema: ;
    td:jsonschema_flatten_subclasses true ;
    td:spec_content "[{'type': 'markdown', 'text': 'The class DataSchema has the following subclasses:\\n\\n- ArraySchema\\n- BooleanSchema\\n- NumberSchema\\n- IntegerSchema\\n- ObjectSchema\\n- StringSchema\\n- NullSchema\\n'}, {'type': 'paragraph', 'segments': [{'text': 'The format string values are known from a fixed set of values and their corresponding format rules defined in [[JSON-SCHEMA]] (Section 7.3 Defined Formats in particular).\\n'}, {'id': 'td-format-validation-known-values', 'text': 'Servients *MAY* use the `format` value to perform additional validation accordingly.\\n'}, {'id': 'td-format-validation-other-values', 'text': 'When a value that is not found in the known set of values is assigned to `format`, such a validation *SHOULD* succeed.\\n'}]}, {'type': 'markdown', 'text': 'Vocabulary terms typed as any `type` (e.g., `const`, `default`) follow data types compatible with JSON Schema (boolean, integer, number, string, object, array, or null).\\n'}, {'type': 'note', 'text': 'The format term is not widely implemented by JSON Schema tools. In addition, the term `format` is being discussed by the JSON Schema standardisation community and may be replaced by another mechanism or removed in a future JSON Schema version.\\n'}]" ;
    td:spec_description "Metadata that describes the data format used. It can be used for validation." .

wotsec:scheme a owl:ObjectProperty ;
    rdfs:label "scheme" ;
    rdfs:range td:SecuritySchemeList ;
    skos:definition "Identification of the security mechanism being configured." ;
    skos:inScheme wotsec: .

xsd:string a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^(((([A-Za-z]{2,3}(-([A-Za-z]{3}(-[A-Za-z]{3}){0,2}))?)|[A-Za-z]{4}|[A-Za-z]{5,8})(-([A-Za-z]{4}))?(-([A-Za-z]{2}|[0-9]{3}))?(-([A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*(-([0-9A-WY-Za-wy-z](-[A-Za-z0-9]{2,8})+))*(-(x(-[A-Za-z0-9]{1,8})+))?)|(x(-[A-Za-z0-9]{1,8})+)|((en-GB-oed|i-ami|i-bnn|i-default|i-enochian|i-hak|i-klingon|i-lux|i-mingo|i-navajo|i-pwn|i-tao|i-tay|i-tsu|sgn-BE-FR|sgn-BE-NL|sgn-CH-DE)|(art-lojban|cel-gaulish|no-bok|no-nyn|zh-guoyu|zh-hakka|zh-min|zh-min-nan|zh-xiang)))$" ] ) ] .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty hctl:sizes ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty hctl:rel ;
                owl:someValuesFrom [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "icon" ] ) ] ] hctl:Link ) .


