@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hctl: <https://www.w3.org/2019/wot/hypermedia#> .
@prefix jsonschema: <https://www.w3.org/2019/wot/json-schema#> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix td: <https://www.w3.org/2019/wot/td#> .
@prefix wotsec: <https://www.w3.org/2019/wot/security#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

jsonschema:propertyName a owl:DatatypeProperty ;
    rdfs:label "propertyName" ;
    rdfs:range xsd:string ;
    skos:definition "Used to store the indexing name in the parent object when this schema appears as a property of an object schema." ;
    skos:inScheme jsonschema: ;
    td:owl_domain "DataSchema" ;
    td:spec_exclude true .

td:hasInstanceConfiguration a owl:ObjectProperty ;
    rdfs:label "hasInstanceConfiguration" ;
    skos:definition "Instantiation, as used here, is a form of non-symmetric equivalence between a scheme and a configuration: whatever statement on the scheme is also true of the configuration but not vice-versa." ;
    skos:inScheme <https://www.w3.org/2019/wot/td> .

<https://www.w3.org/2019/wot/td.owl.ttl> a owl:Ontology ;
    rdfs:label "thing_description" ;
    dcterms:contributor <http://maxime-lefrancois.info/me#>,
        <http://purl.org/net/mpoveda>,
        <https://vcharpenay.link/#me> ;
    dcterms:license "http://purl.org/NET/rdflicense/cc-by4.0" ;
    dcterms:publisher "JsonObj(**{'@type': 'schema:Organization', 'schema:name': 'W3C Web of Things Working Group', 'schema:url': 'https://www.w3.org/WoT/WG/'})" ;
    dcterms:title "Thing Description" ;
    pav:createdBy <mailto:mahda.noura@siemens.com> ;
    pav:createdOn "2023-12-05T00:00:00" ;
    pav:lastUpdatedOn "2026-09-29T00:00:00" ;
    pav:version "1.1" ;
    rdfs:seeAlso <https://www.w3.org/TR/wot-thing-description11/> ;
    skos:definition "Ontology for the W3C Web of Things Thing Description vocabulary." .

jsonschema:ArraySchema a owl:Class ;
    rdfs:label "ArraySchema" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:items ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty jsonschema:minItems ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:maxItems ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:items ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty jsonschema:maxItems ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:minItems ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:minItems ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:maxItems ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( [ owl:intersectionOf ( jsonschema:DataSchema [ owl:complementOf jsonschema:DataSchema ] ) ] [ owl:intersectionOf ( jsonschema:DataSchema [ owl:complementOf jsonschema:DataSchema ] ) ] ) ] jsonschema:DataSchema ) ] ;
            owl:onProperty jsonschema:items ],
        jsonschema:DataSchema ;
    skos:definition "Metadata describing data of type array. This subclass is indicated by the value array assigned to type in DataSchema instances." ;
    skos:exactMatch jsonschema:ArraySchema ;
    skos:inScheme jsonschema: ;
    td:spec_description "Metadata describing data of type array. This subclass is indicated by the value `array` assigned to type in DataSchema instances." .

jsonschema:BooleanSchema a owl:Class ;
    rdfs:label "BooleanSchema" ;
    rdfs:subClassOf jsonschema:DataSchema ;
    skos:definition "Metadata describing data of type boolean. This subclass is indicated by the value boolean assigned to type in DataSchema instances." ;
    skos:exactMatch jsonschema:BooleanSchema ;
    skos:inScheme jsonschema: ;
    td:spec_description "Metadata describing data of type `boolean`. This subclass is indicated by the value `boolean` assigned to type in `DataSchema` instances." .

jsonschema:IntegerSchema a owl:Class ;
    rdfs:label "IntegerSchema" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:minimum ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:maximum ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:multipleOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:exclusiveMinimum ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:exclusiveMaximum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:exclusiveMinimum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:minimum ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:datatypeComplementOf [ a rdfs:Datatype ;
                                        owl:intersectionOf ( [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:integer ;
                                                    owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:integer ;
                                                    owl:withRestrictions ( [ xsd:maxInclusive 0 ] ) ] ) ] ] xsd:integer ) ] ;
            owl:onProperty jsonschema:multipleOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:exclusiveMaximum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:maximum ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty jsonschema:minimum ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty jsonschema:exclusiveMinimum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:multipleOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty jsonschema:maximum ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty jsonschema:exclusiveMaximum ],
        jsonschema:DataSchema ;
    skos:definition "Metadata describing data of type integer. This subclass is indicated by the value integer assigned to type in DataSchema instances." ;
    skos:exactMatch jsonschema:IntegerSchema ;
    skos:inScheme jsonschema: ;
    td:spec_description "Metadata describing data of type `integer`. This Subclass is indicated by the value `integer` assigned to `type` in `DataSchema` instances." .

jsonschema:NullSchema a owl:Class ;
    rdfs:label "NullSchema" ;
    rdfs:subClassOf jsonschema:DataSchema ;
    skos:definition "Metadata describing data of type null. This subclass is indicated by the value null assigned to type in DataSchema instances. This Subclass describes only one acceptable value, namely null. It is important to note that null does not mean the absence of a value. It is analogous to null in JavaScript, None in Python, null in Java and nil in Ruby programming languages. It can be used as part of a oneOf declaration, where it is used to indicate, that the data can also be null." ;
    skos:exactMatch jsonschema:NullSchema ;
    skos:inScheme jsonschema: ;
    td:spec_description "Metadata describing data of type `null`. This subclass is indicated by the value `null` assigned to `type` in `DataSchema` instances. This Subclass describes only one acceptable value, namely `null`. It is important to note that `null` does not mean the absence of a value. It is analogous to `null` in JavaScript, `None` in Python, `null` in Java and `nil` in Ruby programming languages. It can be used as part of a `oneOf` declaration, where it is used to indicate, that the data can also be `null`." .

jsonschema:NumberSchema a owl:Class ;
    rdfs:label "NumberSchema" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty jsonschema:exclusiveMinimum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:exclusiveMinimum ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:datatypeComplementOf [ a rdfs:Datatype ;
                                        owl:intersectionOf ( [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:integer ;
                                                    owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                                    owl:onDatatype xsd:integer ;
                                                    owl:withRestrictions ( [ xsd:maxInclusive 0 ] ) ] ) ] ] xsd:decimal [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty jsonschema:multipleOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:maximum ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty jsonschema:maximum ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:minimum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:maximum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:minimum ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty jsonschema:exclusiveMaximum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:exclusiveMaximum ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:multipleOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:exclusiveMaximum ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty jsonschema:minimum ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:multipleOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:exclusiveMinimum ],
        jsonschema:DataSchema ;
    skos:definition "Metadata describing data of type number. This subclass is indicated by the value number assigned to type in DataSchema instances." ;
    skos:exactMatch jsonschema:NumberSchema ;
    skos:inScheme jsonschema: ;
    td:spec_description "Metadata describing data of type `number`. This subclass is indicated by the value `number` assigned to type in `DataSchema` instances." .

jsonschema:ObjectSchema a owl:Class ;
    rdfs:label "ObjectSchema" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:required ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:properties ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jsonschema:required ],
        [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:DataSchema ;
            owl:onProperty td:properties ],
        jsonschema:DataSchema ;
    skos:definition "Metadata describing data of type object. This subclass is indicated by the value object assigned to type in DataSchema instances." ;
    skos:exactMatch jsonschema:ObjectSchema ;
    skos:inScheme jsonschema: ;
    td:spec_description "Metadata describing data of type Object. This Subclass is indicated by the value `object` assigned to `type` in `DataSchema` instances." .

jsonschema:StringSchema a owl:Class ;
    rdfs:label "StringSchema" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty jsonschema:pattern ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:minLength ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty jsonschema:minLength ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:pattern ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:contentEncoding ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:minLength ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:ContentEncodingList ;
            owl:onProperty jsonschema:contentEncoding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:contentMediaType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty jsonschema:maxLength ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:nonNegativeInteger ;
            owl:onProperty jsonschema:maxLength ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:contentEncoding ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:maxLength ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:contentMediaType ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:ContentMediaTypeList ;
            owl:onProperty jsonschema:contentMediaType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty jsonschema:pattern ],
        jsonschema:DataSchema ;
    skos:definition "Metadata describing data of type string. This subclass is indicated by the value string assigned to type in DataSchema instances." ;
    skos:exactMatch jsonschema:StringSchema ;
    skos:inScheme jsonschema: ;
    td:spec_content "[{'type': 'note', 'text': 'The length of a string (i.e., `minLength` and `maxLength`) is defined as the number of Unicode code points, as defined by [[RFC8259]]. Note that some [user-perceived characters](https://www.w3.org/TR/i18n-glossary/#dfn-grapheme) are composed of more than one Unicode code point. Arbitrary index values might not fall on these grapheme boundaries, so truncation according to `maxLength` might alter the appearance or meaning of the string.\\n'}]" ;
    td:spec_description "Metadata describing data of type `string`. This Subclass is indicated by the value `string` assigned to `type` in `DataSchema` instances." .

wotsec:APIKeySecurityScheme a owl:Class ;
    rdfs:label "APIKeySecurityScheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://www.w3.org/2019/wot/security#@name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://www.w3.org/2019/wot/security#@name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://www.w3.org/2019/wot/security#@name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string "apikey" ) ] ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty wotsec:in ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:SecurityLocationType ;
            owl:onProperty wotsec:in ],
        wotsec:SecurityScheme ;
    skos:definition "API key authentication security configuration identified by the term apikey. This scheme is to be used when the  access token is opaque, for example when a key in an unknown or proprietary format is provided by a cloud service provider." ;
    skos:exactMatch wotsec:APIKeySecurityScheme ;
    skos:inScheme wotsec: ;
    td:spec_description "API key authentication security configuration identified by the Vocabulary Term `apikey` (i.e., \"scheme\": \"apikey\").  This scheme is to be used when the access token is opaque, for example when a key in an unknown or proprietary format is provided by a cloud service provider.  In this case the key may not be using a standard token format.  This scheme indicates that the key provided by the service provider needs to be supplied as part of service requests using the mechanism indicated by the `in` field." .

wotsec:AutoSecurityScheme a owl:Class ;
    rdfs:label "AutoSecurityScheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string "auto" ) ] ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        wotsec:SecurityScheme ;
    skos:definition "An automatic authentication security configuration identified by the term auto. This scheme indicates that the security  parameters are going to be negotiated by the underlying protocols at runtime." ;
    skos:exactMatch wotsec:AutoSecurityScheme ;
    skos:inScheme wotsec: ;
    td:spec_description "An automatic authentication security configuration identified by the term `auto` (i.e., \"scheme\": \"auto\"). This scheme indicates that the security parameters are going to be negotiated by the underlying protocols at runtime, subject to the respective specifications for the protocol (e.g. [[RFC7617]] for Basic Authentication when using HTTP)." .

wotsec:BasicSecurityScheme a owl:Class ;
    rdfs:label "BasicSecurityScheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://www.w3.org/2019/wot/security#@name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:SecurityLocationType ;
            owl:onProperty wotsec:in ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://www.w3.org/2019/wot/security#@name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string "basic" ) ] ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://www.w3.org/2019/wot/security#@name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        wotsec:SecurityScheme ;
    skos:definition "Basic Authentication security configuration using an unencrypted username and password." ;
    skos:exactMatch wotsec:BasicSecurityScheme ;
    skos:inScheme wotsec: ;
    td:spec_description "Basic Authentication [[RFC7617]] security configuration identified by the Vocabulary Term `basic` (i.e., \"scheme\": \"basic\"), using an unencrypted username and password." .

wotsec:BearerSecurityScheme a owl:Class ;
    rdfs:label "BearerSecurityScheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:format ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://www.w3.org/2019/wot/security#@name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string "bearer" ) ] ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:in ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:alg ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://www.w3.org/2019/wot/security#@name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:SecurityLocationType ;
            owl:onProperty wotsec:in ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:alg ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:authorization ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:format ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:AlgList ;
            owl:onProperty wotsec:alg ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:in ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://www.w3.org/2019/wot/security#@name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty wotsec:authorization ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:authorization ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:BearerFormat ;
            owl:onProperty wotsec:format ],
        wotsec:SecurityScheme ;
    skos:definition "Bearer Token security configuration for situations where bearer tokens are used independently of OAuth2." ;
    skos:exactMatch wotsec:BearerSecurityScheme ;
    skos:inScheme wotsec: ;
    td:spec_intro_content "[{'type': 'paragraph', 'segments': [{'text': 'Bearer Token [[RFC6750]] security configuration identified by the Vocabulary Term `bearer` (i.e., \"scheme\": \"bearer\") for situations where bearer tokens are used independently of OAuth2. If the `oauth2` scheme is specified it is not generally necessary to specify this scheme as well as it is implied. For `format`, the value `jwt` indicates conformance with [[RFC7519]], `jws` indicates conformance with [[RFC7797]], `cwt` indicates conformance with [[RFC8392]], and `jwe` indicates conformance with [[RFC7516]], with values for `alg` interpreted consistently with those standards.\\n'}, {'id': 'td-security-bearer-format-extensions', 'text': 'Other formats and algorithms for bearer tokens *MAY* be specified in vocabulary extensions.\\n'}]}]" .

wotsec:ComboSecurityScheme a owl:Class ;
    rdfs:label "ComboSecurityScheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string "combo" ) ] ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 2 ] ) ] ) ] ;
            owl:onProperty wotsec:security_allOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:security_oneOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:security_allOf ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 2 ] ) ] ) ] ;
            owl:onProperty wotsec:security_oneOf ],
        wotsec:SecurityScheme ;
    skos:definition "A combination of other security schemes. Exactly one of either oneOf or allOf vocabulary terms MUST be included." ;
    skos:exactMatch wotsec:ComboSecurityScheme ;
    skos:inScheme wotsec: ;
    td:spec_intro_content "[{'type': 'paragraph', 'segments': [{'text': 'A combination of other security schemes identified by the Vocabulary Term `combo` (i.e., \"scheme\": \"combo\"). Elements of this scheme define various ways in which other named schemes defined in `securityDefinitions`, including other ComboSecurityScheme definitions, are to be combined to create a new scheme definition.\\n'}, {'id': 'td-security-combo-exclusive-oneof-or-allof', 'text': 'Exactly one of either `oneOf` or `allOf` vocabulary terms *MUST* be included.\\n'}, {'text': 'Only security scheme definitions which can be used together can be combined with `allOf`. For example, it is not possible in general to combine different OAuth 2.0 flows together using `allOf` unless one applies to a proxy and one to the endpoint. Note that when multiple named security scheme definitions are listed in a `security` field the same semantics apply as in an `allOf` combination (and the same limitations on allowable combinations). The `oneOf` combination is equivalent to using different security schemes on forms that are otherwise identical. In this sense a `oneOf` scheme is not an essential feature but it does avoid redundancy in such cases.\\n'}]}]" .

wotsec:DigestSecurityScheme a owl:Class ;
    rdfs:label "DigestSecurityScheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string "digest" ) ] ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://www.w3.org/2019/wot/security#@name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:qop ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:SecurityLocationType ;
            owl:onProperty wotsec:in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:in ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:in ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:qop ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://www.w3.org/2019/wot/security#@name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:QoPType ;
            owl:onProperty wotsec:qop ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://www.w3.org/2019/wot/security#@name> ],
        wotsec:SecurityScheme ;
    skos:definition "Digest Access Authentication security configuration. This scheme is similar to basic authentication but with  added features to avoid man-in-the-middle attacks." ;
    skos:exactMatch wotsec:DigestSecurityScheme ;
    skos:inScheme wotsec: ;
    td:spec_description "Digest Access Authentication [[RFC7616]] security configuration identified by the Vocabulary Term `digest` (i.e., \"scheme\": \"digest\"). This scheme is similar to basic authentication but with added features to avoid man-in-the-middle attacks." .

wotsec:NoSecurityScheme a owl:Class ;
    rdfs:label "NoSecurityScheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string "nosec" ) ] ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        wotsec:SecurityScheme ;
    skos:definition "A security configuration indicating there is no authentication or other mechanism required to access the resource." ;
    skos:exactMatch wotsec:NoSecurityScheme ;
    skos:inScheme wotsec: ;
    td:spec_description "A security configuration identified by the Vocabulary Term `nosec` (i.e., \"scheme\": \"nosec\"), indicating there is no authentication or other mechanism required to access the resource." .

wotsec:OAuth2SecurityScheme a owl:Class ;
    rdfs:label "OAuth2SecurityScheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:flow ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:scopes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty wotsec:authorization ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:scopes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:refresh ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:refresh ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty wotsec:flow ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:OAuth2Flow ;
            owl:onProperty wotsec:flow ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:token ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty wotsec:refresh ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:authorization ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:authorization ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string "oauth2" ) ] ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty wotsec:token ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:token ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( xsd:string xsd:string ) ] [ owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                                        owl:datatypeComplementOf xsd:string ] ) ] [ a rdfs:Datatype ;
                                            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                                        owl:datatypeComplementOf xsd:string ] ) ] ) ] ) ] ;
            owl:onProperty wotsec:scopes ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        wotsec:SecurityScheme ;
    skos:definition "OAuth 2.0 authentication security configuration for systems conformant with RFC6749 and RFC8252." ;
    skos:exactMatch wotsec:OAuth2SecurityScheme ;
    skos:inScheme wotsec: ;
    td:spec_content "[{'type': 'paragraph', 'segments': [{'id': 'td-security-oauth2-code-flow', 'text': 'For the code flow, both `authorization` and token vocabulary terms *MUST* be included.\\n'}, {'id': 'td-security-oauth2-client-flow', 'text': 'For the `client` flow, token vocabulary term *MUST* be included.\\n'}, {'id': 'td-security-oauth2-client-flow-no-auth', 'text': 'For the `client` flow, `authorization` vocabulary term *MUST NOT* be included.\\n'}, {'text': 'The mandatory elements for each flow are summarized in the following table:\\n'}]}]" ;
    td:spec_description "OAuth 2.0 authentication security configuration for systems conformant with [[RFC6749]] and [[RFC8252]],  identified by the Vocabulary Term `oauth2` (i.e., \"scheme\": \"oauth2\")." .

wotsec:PSKSecurityScheme a owl:Class ;
    rdfs:label "PSKSecurityScheme" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string "psk" ) ] ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:identity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty wotsec:identity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty wotsec:identity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty wotsec:scheme ],
        wotsec:SecurityScheme ;
    skos:definition "Pre-shared key authentication security configuration. This is meant to identify that a standard is used for  pre-shared keys such as TLS-PSK." ;
    skos:exactMatch wotsec:PSKSecurityScheme ;
    skos:inScheme wotsec: ;
    td:spec_description "Pre-shared key authentication security configuration identified by the Vocabulary Term `psk` (i.e., \"scheme\": \"psk\").  This is meant to identify that a standard is used for pre-shared keys such as TLS-PSK [[RFC4279]],  and that the ciphersuite used for keys will be established during protocol negotiation." .

td:Thing a owl:Class ;
    rdfs:label "Thing" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:actions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:schemaDefinitions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty td:modified ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ owl:unionOf ( [ owl:intersectionOf ( xsd:string [ owl:complementOf rdf:langString ] ) ] [ owl:intersectionOf ( rdf:langString [ owl:complementOf xsd:string ] ) ] ) ] xsd:string ) ] ;
            owl:onProperty td:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:security ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:created ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:created ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:ActionAffordance ;
            owl:onProperty td:actions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:links ],
        [ a owl:Restriction ;
            owl:allValuesFrom wotsec:SecurityScheme ;
            owl:onProperty td:securityDefinitions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:properties ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty td:security ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty td:securityDefinitions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:events ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( [ owl:intersectionOf ( linkml:uri [ owl:complementOf [ owl:unionOf ( xsd:anyURI jsonschema:Any ) ] ] ) ] [ owl:intersectionOf ( [ owl:unionOf ( xsd:anyURI jsonschema:Any ) ] [ owl:complementOf linkml:uri ] ) ] ) ] ;
            owl:onProperty td:atContext ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty td:atContext ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:modified ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:atType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty td:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:support ],
        [ a owl:Restriction ;
            owl:allValuesFrom hctl:Form ;
            owl:onProperty td:forms ],
        [ a owl:Restriction ;
            owl:allValuesFrom hctl:Link ;
            owl:onProperty td:links ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( [ a rdfs:Datatype ;
                                owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                            owl:datatypeComplementOf xsd:string ] ) ] [ a rdfs:Datatype ;
                                owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                            owl:datatypeComplementOf xsd:string ] ) ] ) ] ;
            owl:onProperty td:security ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:modified ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:MultiLanguage ;
            owl:onProperty td:titles ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:descriptions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:uriVariables ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:atContext ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ owl:unionOf ( [ owl:intersectionOf ( xsd:string [ owl:complementOf xsd:string ] ) ] [ owl:intersectionOf ( xsd:string [ owl:complementOf xsd:string ] ) ] ) ] xsd:string ) ] ;
            owl:onProperty td:atType ],
        [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:DataSchema ;
            owl:onProperty td:schemaDefinitions ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( [ a rdfs:Datatype ;
                                owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                            owl:datatypeComplementOf xsd:anyURI ] ) ] [ a rdfs:Datatype ;
                                owl:intersectionOf ( xsd:anyURI [ a rdfs:Datatype ;
                                            owl:datatypeComplementOf xsd:anyURI ] ) ] ) ] ;
            owl:onProperty td:profile ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty td:base ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:profile ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:PropertyAffordance ;
            owl:onProperty td:properties ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty td:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom jsonschema:DataSchema ;
            owl:onProperty td:uriVariables ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:VersionInfo ;
            owl:onProperty td:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:forms ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:EventAffordance ;
            owl:onProperty td:events ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:atType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty td:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom td:MultiLanguage ;
            owl:onProperty td:descriptions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty td:created ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:titles ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty td:support ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:profile ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty td:base ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:support ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty td:base ] ;
    skos:definition "An abstraction of a physical or a virtual entity whose metadata and interfaces are described by a WoT Thing Description, whereas a virtual entity is the composition of one or more Things." ;
    skos:exactMatch td:Thing ;
    skos:inScheme <https://www.w3.org/2019/wot/td> ;
    td:spec_content "[{'type': 'note', 'text': 'The following list items about the `@context` URL rules will go through major changes.\\n'}, {'type': 'markdown', 'text': 'For `@context` the following rules are defined for Thing Description instances:\\n'}, {'type': 'list', 'items': [{'id': 'td-context-ns-thing-mandatory', 'text': 'The `@context` name-value pair *MUST* contain the anyURI `https://www.w3.org/ns/wot-next/td` in order\\nto identify the document as a TD 2.0 which would allow Consumers to use the newly introduced terms.\\n'}, {'id': 'td-context-ns-thing-optional', 'text': 'When `@context` is an Array, the anyURI `https://www.w3.org/ns/wot-next/td` *MAY* be followed by elements of type\\n`anyURI` or type Map in any order, while it is *RECOMMENDED* to include only one Map with all the name-value pairs in the `@context` Array.\\n'}, {'id': 'td-context-ns-thing-map-of-namespaces', 'text': 'Maps contained in an `@context` Array *MAY* contain name-value pairs, where the value is a namespace\\nidentifier of type anyURI and the name a Term or prefix denoting that namespace.\\n'}, {'id': 'td-context-default-language', 'text': 'One Map contained in an `@context` Array *SHOULD* contain a name-value pair that defines the default language\\nfor the Thing Description, where the name is the Term @language and the value is a well-formed language tag as defined by [[BCP47]] (e.g., en, de-AT, gsw-CH, zh-Hans, zh-Hant-HK, sl-nedis).\\n'}]}, {'type': 'markdown', 'text': 'To determine the base direction of all human-readable text in Thing Description and Thing Model instances this specification recommends to follow the [[STRING-META]] guideline about [string-specific directional information](https://www.w3.org/TR/string-meta/#string_specific_direction) when no built-in mechanism for associating base direction metadata is available.\\n'}, {'type': 'paragraph', 'segments': [{'text': 'TD Processors *SHOULD* be aware of certain special cases when processing bidirectional text.\\n'}, {'id': 'td-processor-bidi-isolation', 'text': 'TD Processors *SHOULD* take care to use bidi isolation when presenting strings to users, particularly when embedding in surrounding text (e.g., for Web user interface).\\n'}, {'text': 'Mixed direction text can occur in any language, even when the language is properly identified.\\n'}]}, {'type': 'paragraph', 'segments': [{'id': 'td-producer-mixed-direction', 'text': 'TD producers *SHOULD* attempt to provide mixed direction strings in a way that can be displayed successfully by a naive user agent.\\n'}, {'text': 'For example, if an RTL string begins with an LTR run (such as a number or a brand or trade name in Latin script), including an RLM character at the start of the string or wrapping opposite direction runs in bidi controls can assist in proper display.\\n'}]}, {'type': 'markdown', 'text': '*Strings on the Web: Language and Direction Metadata* string-meta provides some guidance and illustrates a number of pitfalls when using bidirectional text.\\n'}, {'type': 'paragraph', 'segments': [{'text': 'In addition to the explicitly provided Interaction Affordances in the `properties`, `actions`, and `events` Maps, a Thing can also provide meta-interactions, which are indicated by `Form` instances in its optional `forms` Array.\\n'}, {'id': 'td-op-for-thing', 'text': 'When the `forms` Array of a Thing instance contains `Form` instances, it MUST contain `op` member with the string values assigned to the name `op`, either directly or within an Array, MUST be one of the following *operation types*: `readallproperties`, `writeallproperties`, `readmultipleproperties`, `writemultipleproperties`, `observeallproperties`, `unobserveallproperties`, `queryallactions`, `subscribeallevents`, or `unsubscribeallevents`.\\n'}, {'text': '(See [an example](#td-forms-readall-example) for an usage of `form` in a Thing instance.)\\n'}]}, {'type': 'markdown', 'text': 'The data schema for each of the property meta-interactions is constructed by combining the data schemas of each `PropertyAffordance` instance in a single `ObjectSchema` instance, where the `properties` Map of the `ObjectSchema` instance contains each data schema of the `PropertyAffordances` identified by the name of the corresponding `PropertyAffordances` instance.\\n\\nIf not specified otherwise (e.g., through a TD Context Extension), the request data of the `readmultipleproperties` operation is an Array that contains the intended `PropertyAffordances` instance names, which is serialized to the content type specified by the `Form` instance.\\n'}]" .

rdf:langString a rdfs:Datatype .

<https://w3id.org/linkml/uri#array> a owl:Class ;
    rdfs:label "array" ;
    rdfs:subClassOf linkml:uri ;
    skos:definition "Represents an array type" .

<https://w3id.org/linkml/uri#boolean> a owl:Class ;
    rdfs:label "boolean" ;
    rdfs:subClassOf linkml:uri ;
    skos:definition "Represents a boolean type" .

<https://w3id.org/linkml/uri#https%3A%2F%2Fwww.w3.org%2F2019%2Fwot%2Ftd%2Fv1> a owl:Class ;
    rdfs:label "https://www.w3.org/2019/wot/td/v1" ;
    rdfs:subClassOf linkml:uri ;
    skos:definition "WoT Thing Description 1.0 JSON-LD context URI." .

<https://w3id.org/linkml/uri#https%3A%2F%2Fwww.w3.org%2F2022%2Fwot%2Ftd%2Fv1.1> a owl:Class ;
    rdfs:label "https://www.w3.org/2022/wot/td/v1.1" ;
    rdfs:subClassOf linkml:uri ;
    skos:definition "WoT Thing Description 1.1 JSON-LD context URI." .

<https://w3id.org/linkml/uri#https%3A%2F%2Fwww.w3.org%2Fns%2Fwot-next%2Ftd> a owl:Class ;
    rdfs:label "https://www.w3.org/ns/wot-next/td" ;
    rdfs:subClassOf linkml:uri ;
    skos:definition "WoT Thing Description 2.0 JSON-LD context URI." .

<https://w3id.org/linkml/uri#integer> a owl:Class ;
    rdfs:label "integer" ;
    rdfs:subClassOf linkml:uri ;
    skos:definition "Represents an integer type" .

<https://w3id.org/linkml/uri#null> a owl:Class ;
    rdfs:label "null" ;
    rdfs:subClassOf linkml:uri ;
    skos:definition "Represents a null type" .

<https://w3id.org/linkml/uri#number> a owl:Class ;
    rdfs:label "number" ;
    rdfs:subClassOf linkml:uri ;
    skos:definition "Represents a number type" .

<https://w3id.org/linkml/uri#object> a owl:Class ;
    rdfs:label "object" ;
    rdfs:subClassOf linkml:uri ;
    skos:definition "Represents an object type" .

<https://w3id.org/linkml/uri#string> a owl:Class ;
    rdfs:label "string" ;
    rdfs:subClassOf linkml:uri ;
    skos:definition "Represents a string type" .

hctl:additionalResponses a owl:ObjectProperty ;
    rdfs:label "additionalResponses" ;
    rdfs:range hctl:AdditionalExpectedResponse ;
    skos:definition "This optional term can be used if additional expected responses are possible, e.g., for error reporting. Each additional response needs to be distinguished from others in some way (for example, by specifying a protocol-specific error code), and may also have its own data schema." ;
    skos:inScheme hctl: .

jsonschema:allOf a owl:ObjectProperty ;
    rdfs:label "allOf" ;
    rdfs:range jsonschema:DataSchema ;
    skos:definition "Used to ensure that the data is valid against all of the specified schemas in the array." ;
    skos:inScheme jsonschema: ;
    skos:note "The upstream JSON Schema ontology defines `jsonschema:allOf`, but the current TD 2.0 Data Schema vocabulary table does not list it; confirm its inclusion with the WoT Working Group." ;
    td:spec_exclude true .

jsonschema:enum a owl:ObjectProperty ;
    rdfs:label "enum" ;
    rdfs:range jsonschema:Any ;
    skos:definition "Restricted set of values provided as an array." ;
    skos:inScheme jsonschema: .

jsonschema:oneOf a owl:ObjectProperty ;
    rdfs:label "oneOf" ;
    rdfs:range jsonschema:DataSchema ;
    skos:definition "Used to ensure that the data is valid against one of the specified schemas in the array. This can be used to describe multiple input or output schemas." ;
    skos:inScheme jsonschema: .

jsonschema:required a owl:DatatypeProperty ;
    rdfs:label "required" ;
    rdfs:range xsd:string ;
    skos:definition "Defines which members of the object type are mandatory, i.e. which members are mandatory in the payload that is to be sent (e.g., input of invokeaction, writeproperty) and what members will be definitely delivered in the payload that is being received (e.g., output of invokeaction, readproperty)" ;
    skos:inScheme jsonschema: ;
    td:spec_description "Defines which members of the object type are mandatory, i.e. which members are mandatory in the payload that is to be sent (e.g., input of `invokeaction`, `writeproperty`) and what members will be definitely delivered in the payload that is being received (e.g., output of `invokeaction`, `readproperty`)" .

wotsec:security_allOf a owl:DatatypeProperty ;
    rdfs:label "security_allOf" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 2 ] ) ] ) ] ;
    skos:definition "Array of two or more strings identifying other named security scheme definitions, all of which must be satisfied for access." ;
    skos:inScheme wotsec: ;
    skos:prefLabel "allOf" .

wotsec:security_oneOf a owl:DatatypeProperty ;
    rdfs:label "security_oneOf" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 2 ] ) ] ) ] ;
    skos:definition "Array of two or more strings identifying other named security scheme definitions, any one of which, when satisfied, will allow access. Only one may be chosen for use." ;
    skos:inScheme wotsec: ;
    skos:note "In a Combo security scheme, `oneOf` maps to `wotsec:oneOf` rather than the distinct `jsonschema:oneOf` term." ;
    skos:prefLabel "oneOf" .

