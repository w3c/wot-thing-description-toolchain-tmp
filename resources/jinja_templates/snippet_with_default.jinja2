<aside class="example with-default"{% if id %} id="{{ id }}"{% endif %}>
  <div class="marker">
    <span class="example-title">{{ title }}</span>
  </div>
  <div class="with-default-control">
    <input type="checkbox" />
    <span><i>{{ toggle_label }}</i></span>
  </div>
  <pre class="json">
{{ compact_body | safe }}
  </pre>
  <pre class="json">
{{ expanded_body | safe }}
  </pre>
</aside>
