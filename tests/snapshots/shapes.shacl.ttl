wotsec:APIKeySecuritySchemeShape a sh:NodeShape ;
    rdfs:comment "API key authentication security configuration identified by the term apikey. This scheme is to be used when the  access token is opaque, for example when a key in an unknown or proprietary format is provided by a cloud service provider." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "URI of the proxy server this security configuration provides access to. If not given, the corresponding  security configuration is for the endpoint." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path wotsec:proxy ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path td:description ],
        [ sh:description "Specifies the location of security authentication information." ;
            sh:in ( "header" "query" "body" "cookie" "uri" "auto" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path wotsec:apikeyIn ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path td:descriptionInLanguage ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the security scheme definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path td:security_scheme_key ],
        [ sh:datatype xsd:string ;
            sh:description "Name for query, header, cookie, or uri parameters. When used with body location, must be a JSON pointer." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path wotsec:name ],
        [ sh:datatype xsd:string ;
            sh:description "Identification of the security mechanism being configured." ;
            sh:in ( "apikey" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path td:scheme ] ;
    sh:targetClass wotsec:APIKeySecurityScheme .

wotsec:AutoSecuritySchemeShape a sh:NodeShape ;
    rdfs:comment "An automatic authentication security configuration identified by the term auto. This scheme indicates that the security  parameters are going to be negotiated by the underlying protocols at runtime." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path td:descriptionInLanguage ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the security scheme definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path td:security_scheme_key ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path td:description ],
        [ sh:datatype xsd:string ;
            sh:description "Identification of the security mechanism being configured." ;
            sh:in ( "auto" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path td:scheme ],
        [ sh:description "URI of the proxy server this security configuration provides access to. If not given, the corresponding  security configuration is for the endpoint." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path wotsec:proxy ] ;
    sh:targetClass wotsec:AutoSecurityScheme .

wotsec:BasicSecuritySchemeShape a sh:NodeShape ;
    rdfs:comment "Basic Authentication security configuration using an unencrypted username and password." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name for query, header, cookie, or uri parameters. When used with body location, must be a JSON pointer." ;
