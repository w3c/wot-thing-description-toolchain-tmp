@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hctl: <https://www.w3.org/2019/wot/hypermedia#> .
@prefix jsonschema: <https://www.w3.org/2019/wot/json-schema#> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix td: <https://www.w3.org/2019/wot/td#> .
@prefix wotsec: <https://www.w3.org/2019/wot/security#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

linkml:AnyShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:targetClass linkml:Any .

hctl:AdditionalExpectedResponseShape a sh:NodeShape ;
    rdfs:comment "Communication metadata describing the expected response message for additional responses." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Used to define the output data schema for an additional response if it differs from the default output data schema. Rather than a DataSchema object, the name of a previous definition given in a schemaDefinitions map must be used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path hctl:hasAdditionalOutputSchema ],
        [ sh:datatype xsd:string ;
            sh:description "Assign a content type based on a media type (e.g., text/plain) and potential parameters (e.g., charset=utf-8) for the media type [RFC2046]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path hctl:forContentType ],
        [ sh:datatype xsd:boolean ;
            sh:description "Signals if an additional response should not be considered an error." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path hctl:isSuccess ] ;
    sh:targetClass hctl:AdditionalExpectedResponse .

hctl:ExpectedResponseShape a sh:NodeShape ;
    rdfs:comment "Communication metadata describing the expected response message for the primary response." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Assign a content type based on a media type (e.g., text/plain) and potential parameters  (e.g., charset=utf-8) for the media type [RFC2046]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path hctl:forContentType ] ;
    sh:targetClass hctl:ExpectedResponse .

hctl:FormShape a sh:NodeShape ;
    rdfs:comment "A form hypermedia control that describes how an operation can be performed." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Set of authorization scope identifiers provided as an array. These are provided in tokens returned by an  authorization server and associated with forms in order to identify what resources a client may access and how." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 4 ;
            sh:path wotsec:scopes ],
        [ sh:datatype xsd:string ;
            sh:description "A security configuration is a security scheme applied to a (set of) affordance(s)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path td:hasSecurityConfiguration ],
        [ sh:datatype xsd:string ;
            sh:description "Assign a content type based on a media type (e.g., text/plain) and potential parameters  (e.g., charset=utf-8) for the media type [RFC2046]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path hctl:forContentType ],
        [ sh:description "Target URI of a submission target of a Form. See the note on URI/IRI." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path hctl:hasTarget ],
        [ sh:datatype xsd:string ;
            sh:description "Indicates the exact protocol that should be used for additional notifications." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path hctl:forSubProtocol ],
        [ sh:datatype xsd:string ;
            sh:description "Indicates the operation type (e.g., readproperty, writeproperty, observeproperty, etc.)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path hctl:hasOperationType ],
        [ sh:class hctl:AdditionalExpectedResponse ;
            sh:description "This optional term can be used if additional expected responses are possible, e.g., for error reporting. Each additional response needs to be distinguished from others in some way (for example, by specifying a protocol-specific error code), and may also have its own data schema." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path hctl:additionalReturns ],
        [ sh:class hctl:ExpectedResponse ;
            sh:description "This optional term can be used if, e.g., the output communication metadata differ from input metadata (e.g., output contentType differ from the input contentType). The response name contains metadata that is only valid for the primary response messages." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path hctl:returns ],
        [ sh:datatype xsd:string ;
            sh:description "Content coding values indicate an encoding transformation that has been or can be applied to a representation. Content codings are primarily used to allow a representation to be compressed or otherwise usefully transformed without losing the identity of its underlying media type and without loss of information. Examples of content coding include \"gzip\", \"deflate\", etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path hctl:forContentCoding ] ;
    sh:targetClass hctl:Form .

hctl:LinkShape a sh:NodeShape ;
    rdfs:comment "A link can be viewed as a statement of the form \"**_link context_** has a **_relation type_** resource at **_link target_**\", where the optional **_target attributes_** may further describe the resource." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A link relation type identifies the semantics of a link." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path hctl:hasRelationType ],
        [ sh:datatype xsd:string ;
            sh:description "Target attribute providing a hint indicating what the media type [RFC2046] of the result of  dereferencing the link should be." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path hctl:hintsAtMediaType ],
        [ sh:description "Overrides the link context (by default the Thing itself identified by its id) with the given URI or IRI." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path hctl:hasAnchor ],
        [ sh:datatype xsd:string ;
            sh:description "Target attribute that specifies one or more sizes for the referenced icon. Only applicable for relation  type \"icon\". The value pattern follows {Height}x{Width} (e.g., \"16x16\", \"16x16 32x32\")." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path hctl:hasSizes ;
            sh:pattern "^(\\d+x\\d+)(\\s+\\d+x\\d+)*$" ],
        [ sh:description "Target URI of a submission target of a Form. See the note on URI/IRI." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path hctl:hasTarget ],
        [ sh:datatype xsd:string ;
            sh:description "The hreflang attribute specifies the language of a linked document. The value of this must be a valid  language tag [BCP47]." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path hctl:hasHreflang ] ;
    sh:targetClass hctl:Link .

jsonschema:ArraySchemaShape a sh:NodeShape ;
    rdfs:comment "Metadata describing data of type array. This subclass is indicated by the value array assigned to type in DataSchema instances." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Assignment of JSON-based data types compatible with JSON Schema (one of boolean, integer, number, string, object, array, or null)." ;
            sh:in ( "object" "array" "string" "number" "integer" "boolean" "null" ) ;
            sh:maxCount 1 ;
            sh:order 17 ;
            sh:path jsonschema:type ],
        [ sh:datatype xsd:boolean ;
            sh:description "Boolean value that is a hint to indicate whether a property interaction / value is write only (=true) or not (=false). Also see Interaction Semantics for further information on the usage patterns and implications." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path jsonschema:writeOnly ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path td:descriptionInLanguage ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:description "Defines the minimum number of items that have to be in the array." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jsonschema:minItems ],
        [ sh:description "Restricted set of values provided as an array." ;
            sh:order 13 ;
            sh:path jsonschema:enum ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Used to define the characteristics of an array." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path jsonschema:items ],
        [ sh:datatype xsd:boolean ;
            sh:description "Boolean value that is a hint to indicate whether a property interaction / value is read only (=true) or not (=false). Also see Interaction Semantics for further information on the usage patterns and implications." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path jsonschema:readOnly ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path td:description ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Used to ensure that the data is valid against all of the specified schemas in the array." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path jsonschema:allOf ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:description "Defines the maximum number of items that have to be in the array." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jsonschema:maxItems ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Used to ensure that the data is valid against one of the specified schemas in the array. This can be used to describe multiple input or output schemas." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path jsonschema:oneOf ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the data schema definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path td:name ],
        [ sh:description "Provides a constant value." ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path jsonschema:const ],
        [ sh:description "Supply a default value. The value SHOULD validate against the data schema in which it resides." ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path jsonschema:default ],
        [ sh:description "Title of the TD element (Thing, interaction affordance or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path td:title ],
        [ sh:datatype xsd:string ;
            sh:description "Provides unit information that is used, e.g., in international science, engineering, and business. To preserve uniqueness, it is recommended that the value of the unit points to a semantic definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path td:unit ],
        [ sh:class td:MultiLanguage ;
            sh:description "Title of the TD element (Thing, interaction affordance or data schema) with language tag. By convention, a language tag must be added to the object of 'titleInLanguage' triples. Otherwise, use 'title'." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path td:titleInLanguage ],
        [ sh:datatype xsd:string ;
            sh:description "Allows validation based on a format pattern such as \"date-time\", \"email\", \"uri\", etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path jsonschema:format ] ;
    sh:targetClass jsonschema:ArraySchema .

jsonschema:BooleanSchemaShape a sh:NodeShape ;
    rdfs:comment "Metadata describing data of type boolean. This subclass is indicated by the value boolean assigned to type in DataSchema instances." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jsonschema:DataSchema ;
            sh:description "Used to ensure that the data is valid against all of the specified schemas in the array." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path jsonschema:allOf ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Used to ensure that the data is valid against one of the specified schemas in the array. This can be used to describe multiple input or output schemas." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path jsonschema:oneOf ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path td:description ],
        [ sh:description "Provides a constant value." ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path jsonschema:const ],
        [ sh:class td:MultiLanguage ;
            sh:description "Title of the TD element (Thing, interaction affordance or data schema) with language tag. By convention, a language tag must be added to the object of 'titleInLanguage' triples. Otherwise, use 'title'." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path td:titleInLanguage ],
        [ sh:datatype xsd:string ;
            sh:description "Allows validation based on a format pattern such as \"date-time\", \"email\", \"uri\", etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path jsonschema:format ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path td:descriptionInLanguage ],
        [ sh:datatype xsd:string ;
            sh:description "Provides unit information that is used, e.g., in international science, engineering, and business. To preserve uniqueness, it is recommended that the value of the unit points to a semantic definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path td:unit ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the data schema definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path td:name ],
        [ sh:datatype xsd:boolean ;
            sh:description "Boolean value that is a hint to indicate whether a property interaction / value is write only (=true) or not (=false). Also see Interaction Semantics for further information on the usage patterns and implications." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path jsonschema:writeOnly ],
        [ sh:description "Assignment of JSON-based data types compatible with JSON Schema (one of boolean, integer, number, string, object, array, or null)." ;
            sh:in ( "object" "array" "string" "number" "integer" "boolean" "null" ) ;
            sh:maxCount 1 ;
            sh:order 14 ;
            sh:path jsonschema:type ],
        [ sh:description "Restricted set of values provided as an array." ;
            sh:order 10 ;
            sh:path jsonschema:enum ],
        [ sh:description "Title of the TD element (Thing, interaction affordance or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path td:title ],
        [ sh:description "Supply a default value. The value SHOULD validate against the data schema in which it resides." ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path jsonschema:default ],
        [ sh:datatype xsd:boolean ;
            sh:description "Boolean value that is a hint to indicate whether a property interaction / value is read only (=true) or not (=false). Also see Interaction Semantics for further information on the usage patterns and implications." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path jsonschema:readOnly ] ;
    sh:targetClass jsonschema:BooleanSchema .

jsonschema:DataSchemaShape a sh:NodeShape ;
    rdfs:comment "A data schema describes the data format used. It can be used for validation." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type jsonschema:contentEncoding jsonschema:contentMediaType jsonschema:exclusiveMaximum jsonschema:exclusiveMinimum jsonschema:items jsonschema:maxItems jsonschema:maxLength jsonschema:maximum jsonschema:minItems jsonschema:minLength jsonschema:minimum jsonschema:multipleOf jsonschema:pattern jsonschema:required td:hasPropertyAffordance ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name of the data schema definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path td:name ],
        [ sh:description "Provides a constant value." ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path jsonschema:const ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Used to ensure that the data is valid against all of the specified schemas in the array." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path jsonschema:allOf ],
        [ sh:description "Restricted set of values provided as an array." ;
            sh:order 10 ;
            sh:path jsonschema:enum ],
        [ sh:datatype xsd:boolean ;
            sh:description "Boolean value that is a hint to indicate whether a property interaction / value is write only (=true) or not (=false). Also see Interaction Semantics for further information on the usage patterns and implications." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path jsonschema:writeOnly ],
        [ sh:datatype xsd:string ;
            sh:description "Allows validation based on a format pattern such as \"date-time\", \"email\", \"uri\", etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path jsonschema:format ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path td:description ],
        [ sh:class td:MultiLanguage ;
            sh:description "Title of the TD element (Thing, interaction affordance or data schema) with language tag. By convention, a language tag must be added to the object of 'titleInLanguage' triples. Otherwise, use 'title'." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path td:titleInLanguage ],
        [ sh:description "Supply a default value. The value SHOULD validate against the data schema in which it resides." ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path jsonschema:default ],
        [ sh:datatype xsd:boolean ;
            sh:description "Boolean value that is a hint to indicate whether a property interaction / value is read only (=true) or not (=false). Also see Interaction Semantics for further information on the usage patterns and implications." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path jsonschema:readOnly ],
        [ sh:description "Assignment of JSON-based data types compatible with JSON Schema (one of boolean, integer, number, string, object, array, or null)." ;
            sh:in ( "object" "array" "string" "number" "integer" "boolean" "null" ) ;
            sh:maxCount 1 ;
            sh:order 14 ;
            sh:path jsonschema:type ],
        [ sh:datatype xsd:string ;
            sh:description "Provides unit information that is used, e.g., in international science, engineering, and business. To preserve uniqueness, it is recommended that the value of the unit points to a semantic definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path td:unit ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path td:descriptionInLanguage ],
        [ sh:description "Title of the TD element (Thing, interaction affordance or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path td:title ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Used to ensure that the data is valid against one of the specified schemas in the array. This can be used to describe multiple input or output schemas." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path jsonschema:oneOf ] ;
    sh:targetClass jsonschema:DataSchema .

jsonschema:IntegerSchemaShape a sh:NodeShape ;
    rdfs:comment "Metadata describing data of type integer. This subclass is indicated by the value integer assigned to type in DataSchema instances." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class td:MultiLanguage ;
            sh:description "Title of the TD element (Thing, interaction affordance or data schema) with language tag. By convention, a language tag must be added to the object of 'titleInLanguage' triples. Otherwise, use 'title'." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path td:titleInLanguage ],
        [ sh:description "Provides a constant value." ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path jsonschema:const ],
        [ sh:datatype xsd:boolean ;
            sh:description "Boolean value that is a hint to indicate whether a property interaction / value is read only (=true) or not (=false). Also see Interaction Semantics for further information on the usage patterns and implications." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path jsonschema:readOnly ],
        [ sh:datatype xsd:integer ;
            sh:description "Specifies the multipleOf value number. The value must strictly greater than 0. Only applicable for associated number or integer types." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jsonschema:multipleOf ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path td:description ],
        [ sh:datatype xsd:string ;
            sh:description "Allows validation based on a format pattern such as \"date-time\", \"email\", \"uri\", etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path jsonschema:format ],
        [ sh:datatype xsd:integer ;
            sh:description "Specifies a minimum numeric value, representing an exclusive lower limit. Only applicable for associated number or integer types." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jsonschema:exclusiveMinimum ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Used to ensure that the data is valid against all of the specified schemas in the array." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path jsonschema:allOf ],
        [ sh:datatype xsd:string ;
            sh:description "Provides unit information that is used, e.g., in international science, engineering, and business. To preserve uniqueness, it is recommended that the value of the unit points to a semantic definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path td:unit ],
        [ sh:description "Restricted set of values provided as an array." ;
            sh:order 15 ;
            sh:path jsonschema:enum ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Used to ensure that the data is valid against one of the specified schemas in the array. This can be used to describe multiple input or output schemas." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path jsonschema:oneOf ],
        [ sh:description "Title of the TD element (Thing, interaction affordance or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path td:title ],
        [ sh:datatype xsd:boolean ;
            sh:description "Boolean value that is a hint to indicate whether a property interaction / value is write only (=true) or not (=false). Also see Interaction Semantics for further information on the usage patterns and implications." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path jsonschema:writeOnly ],
        [ sh:datatype xsd:integer ;
            sh:description "Specifies a maximum numeric value, representing an exclusive upper limit. Only applicable for associated number or integer types." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jsonschema:exclusiveMaximum ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path td:descriptionInLanguage ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the data schema definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path td:name ],
        [ sh:description "Assignment of JSON-based data types compatible with JSON Schema (one of boolean, integer, number, string, object, array, or null)." ;
            sh:in ( "object" "array" "string" "number" "integer" "boolean" "null" ) ;
            sh:maxCount 1 ;
            sh:order 19 ;
            sh:path jsonschema:type ],
        [ sh:datatype xsd:integer ;
