            sh:order 0 ;
            sh:path wotsec:name ],
        [ sh:description "Specifies the location of security authentication information." ;
            sh:in ( "header" "query" "body" "cookie" "uri" "auto" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path wotsec:in ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path td:description ],
        [ sh:description "URI of the proxy server this security configuration provides access to. If not given, the corresponding  security configuration is for the endpoint." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path wotsec:proxy ],
        [ sh:datatype xsd:string ;
            sh:description "Identification of the security mechanism being configured." ;
            sh:in ( "basic" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path td:scheme ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path td:descriptionInLanguage ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the security scheme definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path td:security_scheme_key ] ;
    sh:targetClass wotsec:BasicSecurityScheme .

wotsec:BearerSecuritySchemeShape a sh:NodeShape ;
    rdfs:comment "Bearer Token security configuration for situations where bearer tokens are used independently of OAuth2." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path td:descriptionInLanguage ],
        [ sh:description "URI of the authorization server." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path wotsec:authorization ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path td:description ],
        [ sh:description "Specifies the location of security authentication information." ;
            sh:in ( "header" "query" "body" "cookie" "uri" "auto" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path wotsec:in ],
        [ sh:description "Specifies format of security authentication information." ;
            sh:in ( "jwt" "jws" "cwt" "jwe" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path wotsec:format ],
        [ sh:description "Encoding, encryption, or digest algorithm (e.g., ES256, ES512-256)." ;
            sh:in ( "ES256" "ES512-256" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path wotsec:alg ],
        [ sh:description "URI of the proxy server this security configuration provides access to. If not given, the corresponding  security configuration is for the endpoint." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path wotsec:proxy ],
        [ sh:datatype xsd:string ;
            sh:description "Name for query, header, cookie, or uri parameters. When used with body location, must be a JSON pointer." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path wotsec:name ],
        [ sh:datatype xsd:string ;
            sh:description "Identification of the security mechanism being configured." ;
            sh:in ( "bearer" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path td:scheme ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the security scheme definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path td:security_scheme_key ] ;
    sh:targetClass wotsec:BearerSecurityScheme .

wotsec:ComboSecuritySchemeShape a sh:NodeShape ;
    rdfs:comment "A combination of other security schemes. Exactly one of either oneOf or allOf vocabulary terms MUST be included." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Array of two or more strings identifying other named security scheme definitions, all of which must be satisfied for access." ;
            sh:minInclusive 2 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path wotsec:allOf ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path td:description ],
        [ sh:description "URI of the proxy server this security configuration provides access to. If not given, the corresponding  security configuration is for the endpoint." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path wotsec:proxy ],
        [ sh:datatype xsd:string ;
            sh:description "Array of two or more strings identifying other named security scheme definitions, any one of which, when satisfied, will allow access. Only one may be chosen for use." ;
            sh:minInclusive 2 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path wotsec:oneOf ],
        [ sh:datatype xsd:string ;
            sh:description "Identification of the security mechanism being configured." ;
            sh:in ( "combo" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path td:scheme ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the security scheme definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path td:security_scheme_key ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path td:descriptionInLanguage ] ;
    sh:targetClass wotsec:ComboSecurityScheme .

wotsec:DigestSecuritySchemeShape a sh:NodeShape ;
    rdfs:comment "Digest Access Authentication security configuration. This scheme is similar to basic authentication but with  added features to avoid man-in-the-middle attacks." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name of the security scheme definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path td:security_scheme_key ],
        [ sh:datatype xsd:string ;
            sh:description "Identification of the security mechanism being configured." ;
            sh:in ( "digest" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path td:scheme ],
        [ sh:datatype xsd:string ;
            sh:description "Name for query, header, cookie, or uri parameters. When used with body location, must be a JSON pointer." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path wotsec:name ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path td:descriptionInLanguage ],
        [ sh:description "URI of the proxy server this security configuration provides access to. If not given, the corresponding  security configuration is for the endpoint." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path wotsec:proxy ],
        [ sh:description "Specifies the location of security authentication information." ;
            sh:in ( "header" "query" "body" "cookie" "uri" "auto" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path wotsec:in ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path td:description ],
        [ sh:description "Quality of protection." ;
            sh:in ( "auth" "auth-int" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path wotsec:qop ] ;
    sh:targetClass wotsec:DigestSecurityScheme .

wotsec:NoSecuritySchemeShape a sh:NodeShape ;
    rdfs:comment "A security configuration indicating there is no authentication or other mechanism required to access the resource." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Name of the security scheme definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path td:security_scheme_key ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path td:descriptionInLanguage ],
        [ sh:description "URI of the proxy server this security configuration provides access to. If not given, the corresponding  security configuration is for the endpoint." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path wotsec:proxy ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path td:description ],
        [ sh:datatype xsd:string ;
            sh:description "Identification of the security mechanism being configured." ;
            sh:in ( "nosec" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path td:scheme ] ;
    sh:targetClass wotsec:NoSecurityScheme .

wotsec:OAuth2SecuritySchemeShape a sh:NodeShape ;
    rdfs:comment "OAuth 2.0 authentication security configuration for systems conformant with RFC6749 and RFC8252." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Identification of the security mechanism being configured." ;
            sh:in ( "oauth2" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path td:scheme ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path td:descriptionInLanguage ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the security scheme definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path td:security_scheme_key ],
        [ sh:description "Authorization flow." ;
            sh:in ( "code" "client" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path wotsec:flow ],
        [ sh:description "URI of the authorization server." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path wotsec:authorization ],
        [ sh:description "URI of the token server." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path wotsec:token ],
        [ sh:description "Set of authorization scope identifiers provided as an array. These are provided in tokens returned by an  authorization server and associated with forms in order to identify what resources a client may access and how." ;
            sh:maxCount 1 ;
            sh:or ( [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] [ sh:datatype xsd:string ;
                        sh:nodeKind sh:Literal ] ) ;
            sh:order 3 ;
            sh:path wotsec:scopes ],
        [ sh:description "URI of the proxy server this security configuration provides access to. If not given, the corresponding  security configuration is for the endpoint." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path wotsec:proxy ],
        [ sh:description "URI of the refresh server." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path wotsec:refresh ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path td:description ] ;
    sh:targetClass wotsec:OAuth2SecurityScheme .

wotsec:PSKSecuritySchemeShape a sh:NodeShape ;
    rdfs:comment "Pre-shared key authentication security configuration. This is meant to identify that a standard is used for  pre-shared keys such as TLS-PSK." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Identification of the security mechanism being configured." ;
            sh:in ( "psk" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path td:scheme ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path td:description ],
        [ sh:description "URI of the proxy server this security configuration provides access to. If not given, the corresponding  security configuration is for the endpoint." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path wotsec:proxy ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path td:descriptionInLanguage ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier providing information which can be used for selection or confirmation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path wotsec:identity ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the security scheme definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path td:security_scheme_key ] ;
    sh:targetClass wotsec:PSKSecurityScheme .

wotsec:SecuritySchemeShape a sh:NodeShape ;
    rdfs:comment "Metadata describing the configuration of a security mechanism. The value assigned to the name scheme MUST be defined  within a Vocabulary included in the Thing Description. For all security schemes, any keys, passwords, or other  sensitive information directly providing access MUST NOT be stored in the TD and should instead be shared and  stored out-of-band via other mechanisms." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type jsonschema:format wotsec:alg wotsec:allOf wotsec:apikeyIn wotsec:authorization wotsec:flow wotsec:identity wotsec:in wotsec:name wotsec:oneOf wotsec:qop wotsec:refresh wotsec:scopes wotsec:token ) ;
    sh:property [ sh:description "URI of the proxy server this security configuration provides access to. If not given, the corresponding  security configuration is for the endpoint." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path wotsec:proxy ],
        [ sh:description "Identification of the security mechanism being configured." ;
            sh:in ( "nosec" "combo" "basic" "digest" "bearer" "psk" "oauth2" "apikey" "auto" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path td:scheme ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path td:description ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path td:descriptionInLanguage ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the security scheme definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path td:security_scheme_key ] ;
    sh:targetClass wotsec:SecurityScheme .

td:ActionAffordanceShape a sh:NodeShape ;
    rdfs:comment "An Interaction Affordance that allows to invoke a function of the Thing, which manipulates state (e.g., toggling a lamp on or off) or triggers a process on the Thing (e.g., dim a lamp over time)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Indexing property to store entity names when serializing them in a JSON-LD @index container." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path td:name ],
        [ sh:class td:MultiLanguage ;
            sh:description "Title of the TD element (Thing, interaction affordance or data schema) with language tag. By convention, a language tag must be added to the object of 'titleInLanguage' triples. Otherwise, use 'title'." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path td:titleInLanguage ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Used to define the output data schema of the action." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path td:hasOutputSchema ],
        [ sh:datatype xsd:boolean ;
            sh:description "Indicates whether the action is idempotent (=true) or not. Informs whether the action can be called repeatedly with the same result, if present, based on the same input." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path td:isIdempotent ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Used to define the input data schema of the action." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path td:hasInputSchema ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path td:description ],
        [ sh:datatype xsd:boolean ;
            sh:description "Indicates whether the action is synchronous (=true) or not. A synchronous action means that the response of action contains all the information about the result of the action and no further querying about the status of the action is needed." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path td:isSynchronous ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Define URI template variables according to RFC6570 as collection based on DataSchema declarations. The individual variables DataSchema cannot be an ObjectSchema or an ArraySchema since each variable needs to be serialized to a string inside the href upon the execution of the operation. If the same variable is both declared in Thing level uriVariables and in Interaction Affordance level, the Interaction Affordance level variable takes precedence." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path td:hasUriTemplateSchema ],
        [ sh:description "Title of the TD element (Thing, interaction affordance or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path td:title ],
        [ sh:class hctl:Form ;
            sh:description "Set of form hypermedia controls that describe how an operation can be performed. Forms are serializations of Protocol Bindings. The array cannot be empty." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path td:hasForm ],
        [ sh:datatype xsd:boolean ;
            sh:description "Signals if the action is safe (=true) or not. Used to signal if there is no internal state (cf. resource state) is changed when invoking an Action. In that case responses can be cached as example." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path td:isSafe ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path td:descriptionInLanguage ] ;
    sh:targetClass td:ActionAffordance .

td:EventAffordanceShape a sh:NodeShape ;
    rdfs:comment "An Interaction Affordance that describes an event source, which asynchronously pushes event data to Consumers (e.g., overheating alerts)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Indexing property to store entity names when serializing them in a JSON-LD @index container." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path td:name ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Defines data that needs to be passed upon subscription, e.g., filters or message format for setting up Webhooks." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path td:hasSubscriptionSchema ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Defines the data schema of the Event instance messages pushed by the Thing." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path td:hasNotificationSchema ],
        [ sh:description "Title of the TD element (Thing, interaction affordance or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path td:title ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path td:descriptionInLanguage ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path td:description ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Defines the data schema of the Event response messages sent by the consumer in a response to a data message." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path td:hasNotificationResponseSchema ],
        [ sh:class hctl:Form ;
            sh:description "Set of form hypermedia controls that describe how an operation can be performed. Forms are serializations of Protocol Bindings. The array cannot be empty." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path td:hasForm ],
        [ sh:class td:MultiLanguage ;
            sh:description "Title of the TD element (Thing, interaction affordance or data schema) with language tag. By convention, a language tag must be added to the object of 'titleInLanguage' triples. Otherwise, use 'title'." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path td:titleInLanguage ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Defines any data that needs to be passed to cancel a subscription, e.g., a specific message to remove a Webhook." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path td:hasCancellationSchema ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Define URI template variables according to RFC6570 as collection based on DataSchema declarations. The individual variables DataSchema cannot be an ObjectSchema or an ArraySchema since each variable needs to be serialized to a string inside the href upon the execution of the operation. If the same variable is both declared in Thing level uriVariables and in Interaction Affordance level, the Interaction Affordance level variable takes precedence." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path td:hasUriTemplateSchema ] ;
    sh:targetClass td:EventAffordance .

td:InteractionAffordanceShape a sh:NodeShape ;
    rdfs:comment "Metadata of a Thing that shows the possible choices to Consumers, thereby suggesting how Consumers may interact with the Thing. There are many types of potential affordances, but W3C WoT defines three types of Interaction Affordances: Properties, Actions, and Events." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type jsonschema:allOf jsonschema:const jsonschema:default jsonschema:enum jsonschema:format jsonschema:oneOf jsonschema:readOnly jsonschema:type jsonschema:writeOnly td:hasCancellationSchema td:hasInputSchema td:hasNotificationResponseSchema td:hasNotificationSchema td:hasOutputSchema td:hasSubscriptionSchema td:isIdempotent td:isObservable td:isSafe td:isSynchronous td:unit ) ;
    sh:property [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path td:description ],
        [ sh:description "Title of the TD element (Thing, interaction affordance or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path td:title ],
        [ sh:class td:MultiLanguage ;
            sh:description "Title of the TD element (Thing, interaction affordance or data schema) with language tag. By convention, a language tag must be added to the object of 'titleInLanguage' triples. Otherwise, use 'title'." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path td:titleInLanguage ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Define URI template variables according to RFC6570 as collection based on DataSchema declarations. The individual variables DataSchema cannot be an ObjectSchema or an ArraySchema since each variable needs to be serialized to a string inside the href upon the execution of the operation. If the same variable is both declared in Thing level uriVariables and in Interaction Affordance level, the Interaction Affordance level variable takes precedence." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path td:hasUriTemplateSchema ],
        [ sh:datatype xsd:string ;
            sh:description "Indexing property to store entity names when serializing them in a JSON-LD @index container." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path td:name ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path td:descriptionInLanguage ],
        [ sh:class hctl:Form ;
            sh:description "Set of form hypermedia controls that describe how an operation can be performed. Forms are serializations of Protocol Bindings. The array cannot be empty." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path td:hasForm ] ;
    sh:targetClass td:InteractionAffordance .

td:MultiLanguageShape a sh:NodeShape ;
    rdfs:comment "A Map providing a set of human-readable texts in different languages identified by language tags as defined in BCP47." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path td:language_value ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path td:language_tag ;
            sh:pattern "^[a-zA-Z]{2,3}(-[a-zA-Z]{3}(-[a-zA-Z]{3}){0,2})?$" ] ;
    sh:targetClass td:MultiLanguage .

td:PropertyAffordanceShape a sh:NodeShape ;
    rdfs:comment "An Interaction Affordance that exposes state of the Thing. This state can be retrieved (read) and/or updated (write). Things can also choose to make Properties observable by pushing the new state after a change." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Restricted set of values provided as an array." ;
            sh:order 11 ;
            sh:path jsonschema:enum ],
        [ sh:class hctl:Form ;
            sh:description "Set of form hypermedia controls that describe how an operation can be performed. Forms are serializations of Protocol Bindings. The array cannot be empty." ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path td:hasForm ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path td:descriptionInLanguage ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path td:description ],
        [ sh:datatype xsd:boolean ;
            sh:description "A hint that indicates whether Servients hosting the Thing and Intermediaries should provide a Protocol Binding that supports the observeproperty and unobserveproperty operations for this Property." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path td:isObservable ],
        [ sh:datatype xsd:boolean ;
            sh:description "Boolean value that is a hint to indicate whether a property interaction / value is read only (=true) or not (=false). Also see Interaction Semantics for further information on the usage patterns and implications." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path jsonschema:readOnly ],
        [ sh:description "Provides a constant value." ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path jsonschema:const ],
        [ sh:datatype xsd:boolean ;
            sh:description "Boolean value that is a hint to indicate whether a property interaction / value is write only (=true) or not (=false). Also see Interaction Semantics for further information on the usage patterns and implications." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path jsonschema:writeOnly ],
        [ sh:description "Supply a default value. The value SHOULD validate against the data schema in which it resides." ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path jsonschema:default ],
        [ sh:description "Title of the TD element (Thing, interaction affordance or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path td:title ],
        [ sh:description "Assignment of JSON-based data types compatible with JSON Schema (one of boolean, integer, number, string, object, array, or null)." ;
            sh:in ( "object" "array" "string" "number" "integer" "boolean" "null" ) ;
            sh:maxCount 1 ;
            sh:order 15 ;
            sh:path jsonschema:type ],
        [ sh:datatype xsd:string ;
            sh:description "Provides unit information that is used, e.g., in international science, engineering, and business. To preserve uniqueness, it is recommended that the value of the unit points to a semantic definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path td:unit ],
        [ sh:datatype xsd:string ;
            sh:description "Name of the data schema definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path td:name ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Used to ensure that the data is valid against one of the specified schemas in the array. This can be used to describe multiple input or output schemas." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path jsonschema:oneOf ],
        [ sh:datatype xsd:string ;
            sh:description "Allows validation based on a format pattern such as \"date-time\", \"email\", \"uri\", etc." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path jsonschema:format ],
        [ sh:class td:MultiLanguage ;
            sh:description "Title of the TD element (Thing, interaction affordance or data schema) with language tag. By convention, a language tag must be added to the object of 'titleInLanguage' triples. Otherwise, use 'title'." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path td:titleInLanguage ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Define URI template variables according to RFC6570 as collection based on DataSchema declarations. The individual variables DataSchema cannot be an ObjectSchema or an ArraySchema since each variable needs to be serialized to a string inside the href upon the execution of the operation. If the same variable is both declared in Thing level uriVariables and in Interaction Affordance level, the Interaction Affordance level variable takes precedence." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path td:hasUriTemplateSchema ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Used to ensure that the data is valid against all of the specified schemas in the array." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path jsonschema:allOf ] ;
    sh:targetClass td:PropertyAffordance .

td:ThingShape a sh:NodeShape ;
    rdfs:comment "An abstraction of a physical or a virtual entity whose metadata and interfaces are described by a WoT Thing Description, whereas a virtual entity is the composition of one or more Things." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class td:MultiLanguage ;
            sh:description "Title of the TD element (Thing, interaction affordance or data schema) with language tag. By convention, a language tag must be added to the object of 'titleInLanguage' triples. Otherwise, use 'title'." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path td:titleInLanguage ],
        [ sh:class td:ActionAffordance ;
            sh:description "All Action-based Interaction Affordances of the Thing." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path td:hasActionAffordance ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Provides information when the TD instance was last modified." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:modified ],
        [ sh:description "Indicates the WoT Profile mechanisms followed by this Thing Description and the corresponding Thing implementation." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path td:followsProfile ],
        [ sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path td:description ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Set of named data schemas. To be used in a schema name-value pair inside an AdditionalExpectedResponse object." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path td:schemaDefinitions ],
        [ sh:description "Identifier of the Thing in form of a URI RFC3986 (e.g., stable URI, temporary and mutable URI, URI with local IP address, URN, etc.)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path td:id ],
        [ sh:class jsonschema:DataSchema ;
            sh:description "Define URI template variables according to RFC6570 as collection based on schema specifications. The individual variables DataSchema cannot be an ObjectSchema or an ArraySchema." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path td:hasUriTemplateSchema ],
        [ sh:class td:EventAffordance ;
            sh:description "All Event-based Interaction Affordances of the Thing." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path td:hasEventAffordance ],
        [ sh:description "Provides information about the TD maintainer as URI scheme (e.g., mailto [[RFC6068]], tel [[RFC3966]], https [[RFC9112]])." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path td:supportContact ],
        [ sh:class wotsec:SecurityScheme ;
            sh:description "A Thing may define abstract security schemes, used to configure the secure access of (a set of) affordance(s)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path td:definesSecurityScheme ],
        [ sh:class td:MultiLanguage ;
            sh:description "Description of the TD element (Thing, interaction affordance, security scheme or data schema) with language tag. By convention, a language tag must be added to the object of 'descriptionInLanguage' triples. Otherwise, use 'description'." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path td:descriptionInLanguage ],
        [ sh:class hctl:Link ;
            sh:description "Provides Web links to arbitrary resources that relate to the specified Thing Description." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path td:hasLink ],
        [ sh:class hctl:Form ;
            sh:description "Set of form hypermedia controls that describe how an operation can be performed. Forms are serializations of Protocol Bindings. The array cannot be empty." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path td:hasForm ],
        [ sh:datatype xsd:string ;
            sh:description "A security configuration is a security scheme applied to a (set of) affordance(s)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path td:hasSecurityConfiguration ],
        [ sh:description "Title of the TD element (Thing, interaction affordance or data schema)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 3 ;
            sh:path td:title ],
        [ sh:description "Define the base URI that is used for all relative URI references throughout a TD document. In TD instances, all relative URIs are resolved relative to the base URI using the algorithm defined in [RFC3986].  base does not affect the URIs used in @context and the IRIs used within Linked Data graphs that are relevant when semantic processing is applied to TD instances." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path td:baseURI ],
        [ sh:class td:VersionInfo ;
            sh:description "Provides version information." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path td:versionInfo ],
        [ sh:class td:PropertyAffordance ;
            sh:description "All Property-based Interaction Affordances of the Thing." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path td:hasPropertyAffordance ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Provides information when the TD instance was created." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:created ] ;
    sh:targetClass td:Thing .

td:VersionInfoShape a sh:NodeShape ;
    rdfs:comment "Metadata of a Thing that provides version information about the TD document. If required, additional version information such as firmware and hardware version (term definitions outside of the TD namespace) can be extended via the TD Context Extension mechanism." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Provides a version indicator of this TD instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path td:instance ],
        [ sh:datatype xsd:string ;
            sh:description "Provides a version indicator of the underlying TM." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path td:model ] ;
    sh:targetClass td:VersionInfo .

