@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hctl: <https://www.w3.org/2019/wot/hypermedia#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix td: <https://www.w3.org/2019/wot/td#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://www.w3.org/2019/wot/hypermedia>
    rdf:type owl:Ontology ;
    dcterms:title "Hypermedia Controls Ontology"@en ;
    rdfs:label "Hypermedia Controls"@en ;
    rdfs:comment "Ontology for the W3C Web of Things Hypermedia Controls vocabulary."@en ;
    vann:preferredNamespacePrefix "hctl" ;
    vann:preferredNamespaceUri "https://www.w3.org/2019/wot/hypermedia#" ;
    owl:versionInfo "td-next" ;
    dcterms:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
    dcterms:creator <mailto:mahda.noura@siemens.com> ;
    dcterms:contributor <https://vcharpenay.link/#me> ;
    dcterms:publisher
        [
            rdf:type schema:Organization ;
            schema:name "W3C Web of Things Working Group" ;
            schema:url <https://www.w3.org/WoT/WG/> ;
        ] ;
.

hctl:AdditionalExpectedResponse
    rdf:type owl:Class ;
    rdfs:label "AdditionalExpectedResponse"@en ;
    skos:definition "Communication metadata describing the expected response message for additional responses."@en ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:ExpectedResponse
    rdf:type owl:Class ;
    rdfs:label "ExpectedResponse"@en ;
    skos:definition "Communication metadata describing the expected response message for the primary response."@en ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:Form
    rdf:type owl:Class ;
    rdfs:label "Form"@en ;
    skos:definition "A form hypermedia control that describes how an operation can be performed."@en ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:Link
    rdf:type owl:Class ;
    rdfs:label "Link"@en ;
    skos:definition "A link can be viewed as a statement of the form \"**_link context_** has a **_relation type_** resource at **_link target_**\", where the optional **_target attributes_** may further describe the resource."@en ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:additionalReturns
    rdf:type owl:ObjectProperty ;
    rdfs:label "additionalReturns"@en ;
    skos:definition "This optional term can be used if additional expected responses are possible, e.g., for error reporting. Each additional response needs to be distinguished from others in some way (for example, by specifying a protocol-specific error code), and may also have its own data schema."@en ;
    rdfs:domain hctl:Form ;
    rdfs:range hctl:AdditionalExpectedResponse ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:forContentCoding
    rdf:type owl:DatatypeProperty ;
    rdfs:label "forContentCoding"@en ;
    skos:definition "Content coding values indicate an encoding transformation that has been or can be applied to a representation. Content codings are primarily used to allow a representation to be compressed or otherwise usefully transformed without losing the identity of its underlying media type and without loss of information. Examples of content coding include \"gzip\", \"deflate\", etc."@en ;
    rdfs:domain hctl:Form ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:forContentType
    rdf:type owl:DatatypeProperty ;
    rdfs:label "forContentType"@en ;
    skos:definition "Assign a content type based on a media type (e.g., text/plain) and potential parameters (e.g., charset=utf-8) for the media type [RFC2046]."@en ;
    schema:domainIncludes
        hctl:AdditionalExpectedResponse ,
        hctl:ExpectedResponse ,
        hctl:Form ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:forSubProtocol
    rdf:type owl:DatatypeProperty ;
    rdfs:label "forSubProtocol"@en ;
    skos:definition "Indicates the exact protocol that should be used for additional notifications."@en ;
    rdfs:domain hctl:Form ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:hasAdditionalOutputSchema
    rdf:type owl:ObjectProperty ;
    rdfs:label "hasAdditionalOutputSchema"@en ;
    skos:definition "Used to define the output data schema for an additional response if it differs from the default output data schema. Rather than a DataSchema object, the name of a previous definition given in a schemaDefinitions map must be used."@en ;
    rdfs:domain hctl:AdditionalExpectedResponse ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:hasAnchor
    rdf:type owl:ObjectProperty ;
    rdfs:label "hasAnchor"@en ;
    skos:definition "Overrides the link context (by default the Thing itself identified by its id) with the given URI or IRI."@en ;
    rdfs:domain hctl:Link ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:hasHreflang
    rdf:type owl:DatatypeProperty ;
    rdfs:label "hasHreflang"@en ;
    skos:definition "The hreflang attribute specifies the language of a linked document. The value of this must be a valid  language tag [BCP47]."@en ;
    rdfs:domain hctl:Link ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
    skos:note "The hreflang attribute is allowed to be a string or array in this version of the spec" ;
.

hctl:hasOperationType
    rdf:type owl:ObjectProperty ;
    rdfs:label "hasOperationType"@en ;
    skos:definition "Indicates the operation type (e.g., readproperty, writeproperty, observeproperty, etc.)"@en ;
    rdfs:domain hctl:Form ;
    rdfs:range td:OperationType ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:hasRelationType
    rdf:type owl:DatatypeProperty ;
    rdfs:label "hasRelationType"@en ;
    skos:definition "A link relation type identifies the semantics of a link."@en ;
    rdfs:domain hctl:Link ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
    skos:note "Recommended to use IANA Link Relations when possible" ;
.

hctl:hasSizes
    rdf:type owl:DatatypeProperty ;
    rdfs:label "hasSizes"@en ;
    skos:definition "Target attribute that specifies one or more sizes for the referenced icon. Only applicable for relation  type \"icon\". The value pattern follows {Height}x{Width} (e.g., \"16x16\", \"16x16 32x32\")."@en ;
    rdfs:domain hctl:Link ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:hasTarget
    rdf:type owl:DatatypeProperty ;
    rdfs:label "hasTarget"@en ;
    skos:definition "Target URI of a submission target of a Form. See the note on URI/IRI."@en ;
    schema:domainIncludes
        hctl:Form ,
        hctl:Link ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:hintsAtMediaType
    rdf:type owl:DatatypeProperty ;
    rdfs:label "hintsAtMediaType"@en ;
    skos:definition "Target attribute providing a hint indicating what the media type [RFC2046] of the result of  dereferencing the link should be."@en ;
    rdfs:domain hctl:Link ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:isSuccess
    rdf:type owl:DatatypeProperty ;
    rdfs:label "isSuccess"@en ;
    skos:definition "Signals if an additional response should not be considered an error."@en ;
    rdfs:domain hctl:AdditionalExpectedResponse ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.

hctl:returns
    rdf:type owl:ObjectProperty ;
    rdfs:label "returns"@en ;
    skos:definition "This optional term can be used if, e.g., the output communication metadata differ from input metadata (e.g., output contentType differ from the input contentType). The response name contains metadata that is only valid for the primary response messages."@en ;
    rdfs:domain hctl:Form ;
    rdfs:range hctl:ExpectedResponse ;
    rdfs:isDefinedBy <https://www.w3.org/2019/wot/hypermedia> ;
    skos:inScheme <https://www.w3.org/2019/wot/hypermedia> ;
.
