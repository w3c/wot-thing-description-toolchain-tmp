{
  "@context": "https://www.w3.org/ns/wot-next/td",
  "title": "Constraint probe",
  "securityDefinitions": {
    "nosec_sc": {
      "scheme": "nosec"
    }
  },
  "security": "nosec_sc",
  "actions": {
    "toggle": {
      "forms": [
