{
  "@context": "https://www.w3.org/ns/wot-next/td",
  "title": "t",
  "securityDefinitions": {
    "nosec_sc": {
      "scheme": "nosec"
    }
  },
  "security": "nosec_sc",
  "properties": {
    "p": {
      "type": "string",
