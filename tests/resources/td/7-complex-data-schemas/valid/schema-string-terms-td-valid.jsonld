{
  "@context": "https://www.w3.org/ns/wot-next/td",
  "title": "t",
  "securityDefinitions": {
    "nosec_sc": {
      "scheme": "nosec"
    }
  },
  "security": "nosec_sc",
  "properties": {
    "p": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8,
        "pattern": "^[a-z]+$",
        "contentEncoding": "base64",
        "contentMediaType": "image/png"
      },
      "forms": [
        {
          "href": "https://example.com/p"
        }
      ]
    }
  }
}
