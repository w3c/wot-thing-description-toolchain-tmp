{
  "@context": "https://www.w3.org/ns/wot-next/td",
  "title": "Constraint probe",
  "securityDefinitions": {
    "oauth2_sc": {
      "scheme": "oauth2",
      "flow": "client",
      "token": "https://example.com/token",
      "scopes": [
        "limited",
        "special"
      ]
    }
  },
  "security": "oauth2_sc",
  "properties": {
    "status": {
      "type": "string",
      "forms": [
        {
          "href": "https://example.com/status",
          "scopes": [
            1
          ]
        }
      ]
    }
  }
}
