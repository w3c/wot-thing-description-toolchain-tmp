{
  "@context": "https://www.w3.org/ns/wot-next/td",
  "title": "Constraint probe",
  "securityDefinitions": {
    "nosec_sc": {
      "scheme": "nosec"
    }
  },
  "security": "nosec_sc",
  "properties": {
    "status": {
      "type": "string",
      "forms": [
        {
          "href": "https://example.com/status"
        }
      ]
    }
  },
  "forms": [
    {
      "href": "https://example.com/properties",
      "op": "readallproperties",
      "scopes": 1
    }
  ]
}
