{
  "@context": "https://www.w3.org/ns/wot-next/td",
  "title": "Constraint probe",
  "securityDefinitions": {
    "basic_sc": {
      "scheme": "basic"
    },
    "digest_sc": {
      "scheme": "digest"
    },
    "combo_sc": {
      "scheme": "combo",
      "oneOf": [
        "basic_sc",
        "digest_sc"
      ]
    }
  },
  "security": "combo_sc"
}
