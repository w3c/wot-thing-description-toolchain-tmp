{
  "@context": ["https://www.w3.org/ns/wot-next/td"],
  "@type": "Thing",
  "id": "urn:example:thing:actions1",
  "title": "Example Thing with Actions",
  "securityDefinitions": {
    "nosec_sc": {
      "scheme": "nosec"
    }
  },
  "security": ["nosec_sc"],
  "actions": {
    "toggle": {
      "forms": [{
        "href": "https://example.com/actions/toggle"
      }]
    }
  }
}